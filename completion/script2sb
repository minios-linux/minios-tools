_script2sb() {
    local cur prev words cword
    _init_completion -n = || return

    if [[ ${words[*]} =~ --help ]] || [[ ${words[*]} =~ --version ]]; then
        return
    fi

    case $prev in
    -d | --directory | -n | --name | -s | --script)
        _filedir
        return
        ;;
    -l | --level)
        COMPREPLY=($(compgen -W '00 01 02 03 04 05 06 07 08 09' -- "$cur"))
        return
        ;;
    -c | --comp)
        COMPREPLY=($(compgen -W 'zstd gzip lzo lz4 xz' -- "$cur"))
        return
        ;;
    -b | --bext)
        COMPREPLY=($(compgen -W 'sb sqfs sfs' -- "$cur"))
        return
        ;;
    esac

    if [[ $cur == *=* ]]; then
        local opt=${cur%%=*}
        cur=${cur#*=}
        case $opt in
        --directory | --name | --script)
            _filedir
            return
            ;;
        --level)
            COMPREPLY=($(compgen -W '00 01 02 03 04 05 06 07 08 09' -- "$cur"))
            return
            ;;
        --comp)
            COMPREPLY=($(compgen -W 'zstd gzip lzo lz4 xz' -- "$cur"))
            return
            ;;
        --bext)
            COMPREPLY=($(compgen -W 'sb sqfs sfs' -- "$cur"))
            return
            ;;
        esac
    fi

    if [[ $cur == --* ]]; then
        COMPREPLY=($(compgen -W '--bext --comp --directory --name --level --script --json --help --version' -- "$cur"))
    elif [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W '-b -c -d -n -l -s --json --help --version' -- "$cur"))
    fi
}

complete -F _script2sb script2sb
