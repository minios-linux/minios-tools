_chroot2sb() {
    local cur prev words cword command
    _init_completion -n = || return

    command=${words[1]:-}
    case $command in
    shell)
        return
        ;;
    finish | cancel)
        if [[ $cur == --* ]]; then
            COMPREPLY=($(compgen -W '--json' -- "$cur"))
        fi
        return
        ;;
    prepare) ;;
    esac

    case $prev in
    -d | --directory | -n | --name)
        _filedir
        return
        ;;
    -l | --level)
        COMPREPLY=($(compgen -W '00 01 02 03 04 05 06 07 08 09' -- "$cur"))
        return
        ;;
    -c | --comp)
        COMPREPLY=($(compgen -W 'zstd gzip lzo lz4 xz' -- "$cur"))
        return
        ;;
    -b | --bext)
        COMPREPLY=($(compgen -W 'sb sqfs sfs' -- "$cur"))
        return
        ;;
    esac

    if (( cword == 1 )); then
        if [[ $cur == -* ]]; then
            COMPREPLY=($(compgen -W '-b -c -d -n -l --bext --comp --directory --name --level --help --version' -- "$cur"))
        else
            COMPREPLY=($(compgen -W 'prepare shell finish cancel' -- "$cur"))
        fi
        return
    fi

    if [[ $command == prepare && $cur == --* ]]; then
        COMPREPLY=($(compgen -W '--bext --comp --directory --name --level --json' -- "$cur"))
    elif [[ $cur == --* ]]; then
        COMPREPLY=($(compgen -W '--bext --comp --directory --name --level --help --version' -- "$cur"))
    elif [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W '-b -c -d -n -l --help --version' -- "$cur"))
    fi
}

complete -F _chroot2sb chroot2sb
