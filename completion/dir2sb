# shellcheck shell=bash disable=SC2034
_dir2sb() {
    local cur prev words cword
    local word option
    _init_completion -n = || return

    for word in "${words[@]}"; do
        [[ $word != --help && $word != --version ]] || return
    done

    case $prev in
    -c | --comp)
        mapfile -t COMPREPLY < <(compgen -W 'zstd gzip lzo lz4 xz' -- "$cur")
        return
        ;;
    -b | --bext)
        mapfile -t COMPREPLY < <(compgen -W 'sb sqfs sfs' -- "$cur")
        return
        ;;
    esac

    if [[ $cur == *=* ]]; then
        option=${cur%%=*}
        cur=${cur#*=}
        case $option in
        --comp)
            mapfile -t COMPREPLY < <(compgen -W 'zstd gzip lzo lz4 xz' -- "$cur")
            return
            ;;
        --bext)
            mapfile -t COMPREPLY < <(compgen -W 'sb sqfs sfs' -- "$cur")
            return
            ;;
        esac
    fi

    if [[ $cur == --* ]]; then
        mapfile -t COMPREPLY < <(compgen -W \
            '--comp --bext --keep-ownership --allow-special --json --no-color --help --version' -- "$cur")
    elif [[ $cur == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W \
            '-c -b --comp --bext --keep-ownership --allow-special --json --no-color --help --version' -- "$cur")
    else
        mapfile -t COMPREPLY < <(compgen -d -- "$cur")
        local IFS=$'\n'
        mapfile -O "${#COMPREPLY[@]}" -t COMPREPLY < <(compgen -f -X '!*.sb' -- "$cur")
    fi
}

complete -F _dir2sb dir2sb
