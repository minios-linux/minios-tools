#!/bin/bash
# Author: crims0n <https://minios.dev>
set -e
set -o pipefail
set -u

VERSION="1.2.4"
BEXT="sb"
COMP_TYPE="zstd"
FILTER_LEVEL=""
FILENAME=""
TMP=""
CHANGES=""
UNION=""
BUNDLES=""
SYSTEMCHANGES=""
RESOLV_BACKUP=""
RESOLV_HAD_UPPER=false
JSON_OUTPUT=false
SAVECHANGES_JSON=""

# Force classic mount(2) syscall to work around an overlayfs bug in util-linux >= 2.39.0
export LIBMOUNT_FORCE_MOUNT2="always"
export TEXTDOMAIN="minios-tools"

declare -a APT_OPTIONS=()
declare -a PACKAGES=()
declare -a PACKAGE_ARGS=()
declare -a LOCAL_PACKAGE_SOURCES=()
declare -a LOCAL_PACKAGE_DESTS=()

help() {
    echo "$(gettext "Usage"): $(basename "$0") COMMAND [OPTIONS] PACKAGE1 [PACKAGE2] [...]"
    echo "$(gettext "Installs packages from repositories and packages them into a module.")"
    echo ""
    echo "$(gettext "Commands"):"
    echo "  install                     $(gettext "Install package(s)")"
    echo "  upgrade                     $(gettext "Upgrade installed packages")"
    echo ""
    echo "$(gettext "Options"):"
    echo "  -n, --name NAME             $(gettext "Use NAME as the filename for the module instead of PACKAGE1").$BEXT"
    echo "  -l, --level LEVEL           $(gettext "Use LEVEL as the filter level")"
    echo "  -c, --comp TYPE             $(gettext "Compression type (zstd, gzip, lzo, xz). Default: zstd")"
    echo "  -b, --bext EXT              $(gettext "Bundle extension. Default: sb")"
    echo "      --json                  $(gettext "Emit machine-readable phase events and result")"
    echo "      --help                  $(gettext "Display this help and exit")"
    echo "      --version               $(gettext "Display version information and exit")"
    echo ""
    echo "$(gettext "Apt Options (for install/upgrade command)"):"
    echo "  -y, --yes                   $(gettext "Automatic yes to prompts")"
    echo "      --allow-downgrades      $(gettext "Allow downgrades of packages")"
    echo "      --install-recommends    $(gettext "Consider recommended packages as a dependency for installing")"
    echo "      --install-suggests      $(gettext "Consider suggested packages as a dependency for installing")"
    echo "      --no-install-recommends $(gettext "Do not consider recommended packages as a dependency for installing")"
    echo "      --no-install-suggests   $(gettext "Do not consider suggested packages as a dependency for installing")"
    echo "  -t, --target-release REL    $(gettext "Default release for package installation")"
    echo ""
    echo "$(gettext "Examples"):"
    echo "  $(basename "$0") install chromium chromium-sandbox"
    echo "  $(basename "$0") install -y --level 03 chromium chromium-sandbox"
    echo "  $(basename "$0") install -y --no-install-recommends ./google-chrome-stable_current_amd64.deb -n 06-google-chrome.$BEXT -l 3"
    echo "  $(basename "$0") upgrade"
    exit 0
}

brief_help() {
    if [[ $JSON_OUTPUT == true ]]; then
        echo "$(gettext "Usage"): $(basename "$0") COMMAND [OPTIONS] PACKAGE1 [PACKAGE2] [...]" >&2
        echo "$(gettext "Try") '$(basename "$0") --help' $(gettext "for more information.")" >&2
    else
        echo "$(gettext "Usage"): $(basename "$0") COMMAND [OPTIONS] PACKAGE1 [PACKAGE2] [...]"
        echo "$(gettext "Try") '$(basename "$0") --help' $(gettext "for more information.")"
    fi
    exit 1
}

version() {
    echo "$(basename "$0") $VERSION"
    exit 0
}

helper_path() {
    local NAME="$1" SCRIPT_PATH SCRIPT_DIR CANDIDATE
    SCRIPT_PATH=$(realpath -m -- "${BASH_SOURCE[0]}" 2>/dev/null || true)
    SCRIPT_DIR=${SCRIPT_PATH%/*}
    for CANDIDATE in \
        "$SCRIPT_DIR/../lib/$NAME" \
        "$SCRIPT_DIR/../lib/minios-tools/$NAME" \
        "/usr/lib/minios-tools/$NAME"; do
        [[ -f $CANDIDATE ]] || continue
        realpath -e -- "$CANDIDATE"
        return 0
    done
    return 1
}

run_protocol() {
    local HELPER PYTHON
    HELPER=$(helper_path minios_protocol.py) || {
        echo "MiniOS Tools protocol helper is unavailable." >&2
        return 1
    }
    PYTHON=$(command -v python3) || {
        echo "python3 is required." >&2
        return 1
    }
    "$PYTHON" -I "$HELPER" "$@"
}

run_convert_engine() {
    local ENGINE PYTHON
    ENGINE=$(helper_path minios_convert_engine.py) || {
        echo "MiniOS Tools filesystem engine is unavailable." >&2
        return 1
    }
    PYTHON=$(command -v python3) || {
        echo "python3 is required." >&2
        return 1
    }
    "$PYTHON" -I "$ENGINE" "$@"
}

machine_phase() {
    [[ $JSON_OUTPUT == true ]] || return 0
    run_protocol phase "$1"
}

message() {
    if [[ $JSON_OUTPUT == true ]]; then
        printf '%s\n' "$*" >&2
    else
        printf '%s\n' "$*"
    fi
}

run_visible() {
    if [[ $JSON_OUTPUT == true ]]; then
        "$@" >&2
    else
        "$@"
    fi
}

option_requires_value() {
    local option=$1
    local count=$2
    if (( count < 2 )); then
        echo "Option requires an argument: $option" >&2
        brief_help
    fi
}

validate_comp() {
    case $1 in
    zstd | gzip | lzo | xz) ;;
    *)
        echo "Invalid compression type: $1" >&2
        brief_help
        ;;
    esac
}

validate_level() {
    [[ $1 =~ ^[0-9]+$ ]] || {
        echo "Invalid filter level: $1" >&2
        brief_help
    }
}

aufs_is_supported() {
    grep -q aufs /proc/filesystems
}

is_mounted() {
    findmnt -rn --mountpoint "$1" >/dev/null 2>&1
}

safe_umount() {
    local mount_point=$1
    local attempt

    is_mounted "$mount_point" || return 0

    for attempt in 1 2 3; do
        umount "$mount_point" 2>/dev/null || true
        is_mounted "$mount_point" || return 0
        sleep 0.5
    done

    ! is_mounted "$mount_point"
}

has_mounts_under() {
    local root=$1
    local target
    local mounts

    mounts=$(findmnt -rn -o TARGET) || return 0
    while IFS= read -r target; do
        [[ $target == "$root" || $target == "$root/"* ]] && return 0
    done <<<"$mounts"
    return 1
}

detach_chroot_mounts() {
    local ok=true
    local mount_point

    for mount_point in "$UNION/sys" "$UNION/proc" "$UNION/dev/pts" "$UNION/dev"; do
        safe_umount "$mount_point" || ok=false
    done
    [[ $ok == true ]]
}

restore_resolv_conf() {
    [[ -n $CHANGES ]] || return 0
    rm -f -- "$CHANGES/etc/resolv.conf" 2>/dev/null || true
    if [[ $RESOLV_HAD_UPPER == true && -n $RESOLV_BACKUP ]]; then
        mkdir -p -- "$CHANGES/etc"
        cp -a -- "$RESOLV_BACKUP" "$CHANGES/etc/resolv.conf"
    fi
}

cleanup() {
    local status=$?
    local cleanup_failed=false

    trap - EXIT
    set +e

    if [[ -n $UNION ]]; then
        detach_chroot_mounts || cleanup_failed=true
        safe_umount "$UNION" || cleanup_failed=true
    fi

    if [[ -n $TMP ]]; then
        if has_mounts_under "$TMP"; then
            cleanup_failed=true
        else
            rm -rf -- "$TMP"
        fi
    fi

    if [[ $cleanup_failed == true ]]; then
        echo "Cleanup incomplete; temporary directory was preserved: $TMP" >&2
        (( status == 0 )) && status=1
    fi

    exit "$status"
}

require_live_layout() {
    if [[ -d /run/initramfs/memory/bundles && -d /run/initramfs/memory/changes ]]; then
        BUNDLES=/run/initramfs/memory/bundles
        SYSTEMCHANGES=/run/initramfs/memory/changes
    elif [[ -d /lib/live/mount/bundles && -d /lib/live/mount/changes ]]; then
        BUNDLES=/lib/live/mount/bundles
        SYSTEMCHANGES=/lib/live/mount/changes
    else
        echo "This command requires a supported MiniOS live session." >&2
        exit 1
    fi
}

build_lowers() {
    local roflag=""
    local bundle prefix
    local i
    local -a bundles=()
    local -a lowers=()

    aufs_is_supported && roflag="=ro"

    shopt -s nullglob
    bundles=("$BUNDLES"/*)
    shopt -u nullglob
    (( ${#bundles[@]} > 0 )) || {
        echo "No MiniOS bundles found in $BUNDLES." >&2
        exit 1
    }

    for (( i=${#bundles[@]}-1; i>=0; i-- )); do
        bundle=${bundles[$i]}
        if [[ -n $FILTER_LEVEL ]]; then
            prefix=${bundle##*/}
            if [[ $prefix =~ ^([0-9]+) ]] && (( 10#${BASH_REMATCH[1]} > 10#$FILTER_LEVEL )); then
                continue
            fi
        fi
        lowers+=("$bundle$roflag")
    done

    (( ${#lowers[@]} > 0 )) || {
        echo "No MiniOS bundles remain after applying the filter level." >&2
        exit 1
    }

    local IFS=:
    LOWERS=${lowers[*]}
}

write_aufs_branch_inventory() {
    local output=$1 upper=$2 lowers=$3
    (
        umask 077
        {
            printf '%s=rw\n' "$upper"
            printf '%s\n' "$lowers" | tr ':' '\n'
        } >"$output"
    )
}

prepare_local_packages() {
    local package path destination
    local index=0

    PACKAGE_ARGS=()
    LOCAL_PACKAGE_SOURCES=()
    LOCAL_PACKAGE_DESTS=()
    for package in "${PACKAGES[@]}"; do
        if [[ $package == */* ]]; then
            path=$(realpath -m -- "$package" 2>/dev/null || true)
            [[ -n $path ]] || {
                echo "Cannot resolve local package path: $package" >&2
                exit 1
            }
            destination="/tmp/apt2sb-packages/${index}-${path##*/}"
            LOCAL_PACKAGE_SOURCES+=("$path")
            LOCAL_PACKAGE_DESTS+=("$destination")
            PACKAGE_ARGS+=("$destination")
            ((index+=1))
        else
            PACKAGE_ARGS+=("$package")
        fi
    done
}

print_command() {
    if [[ $JSON_OUTPUT == true ]]; then
        printf 'Executing:' >&2
        printf ' %q' "$@" >&2
        printf '\n' >&2
    else
        printf 'Executing:'
        printf ' %q' "$@"
        printf '\n'
    fi
}

if (( $# == 0 )); then
    brief_help
fi

APT_COMMAND=$1
shift

case $APT_COMMAND in
--help) help ;;
--version) version ;;
install | upgrade) ;;
*)
    echo "Invalid command entered. Please enter a valid command." >&2
    echo "Valid commands are: install upgrade" >&2
    echo "" >&2
    brief_help
    ;;
esac

VALID_APT_OPTIONS=(-y --yes --allow-downgrades --install-recommends --install-suggests --no-install-recommends --no-install-suggests)

while (( $# > 0 )); do
    case $1 in
    -n | --name)
        option_requires_value "$1" "$#"
        [[ -n $2 ]] || { echo "Option requires a non-empty argument: $1" >&2; brief_help; }
        FILENAME=$2
        shift 2
        ;;
    -l | --level)
        option_requires_value "$1" "$#"
        validate_level "$2"
        printf -v FILTER_LEVEL '%02d' "$((10#$2))"
        shift 2
        ;;
    -c | --comp)
        option_requires_value "$1" "$#"
        validate_comp "$2"
        COMP_TYPE=$2
        shift 2
        ;;
    -b | --bext)
        option_requires_value "$1" "$#"
        [[ -n $2 ]] || { echo "Option requires a non-empty argument: $1" >&2; brief_help; }
        BEXT=$2
        shift 2
        ;;
    -t | --target-release)
        [[ $APT_COMMAND == install ]] || { echo "--target-release is valid only for install." >&2; exit 1; }
        option_requires_value "$1" "$#"
        [[ -n $2 ]] || { echo "--target-release requires a release." >&2; exit 1; }
        APT_OPTIONS+=(--target-release "$2")
        shift 2
        ;;
    --json) JSON_OUTPUT=true; shift ;;
    --help) help ;;
    --version) version ;;
    -*)
        valid=false
        for option in "${VALID_APT_OPTIONS[@]}"; do
            if [[ $1 == "$option" ]]; then
                valid=true
                break
            fi
        done
        if [[ $valid != true ]]; then
            echo "'$1' is not a valid apt option." >&2
            brief_help
        fi
        APT_OPTIONS+=("$1")
        shift
        ;;
    *)
        PACKAGES+=("$1")
        shift
        ;;
    esac
done

if [[ $APT_COMMAND == install && ${#PACKAGES[@]} -eq 0 ]]; then
    brief_help
fi
if [[ $APT_COMMAND == upgrade && ${#PACKAGES[@]} -ne 0 ]]; then
    echo "The upgrade command does not accept package operands." >&2
    brief_help
fi

if (( EUID != 0 )); then
    echo "This script must be run as root." >&2
    brief_help
fi
if [[ -n ${PKEXEC_UID:-} && ! $PKEXEC_UID =~ ^[0-9]+$ ]]; then
    echo "Invalid PKEXEC_UID." >&2
    exit 1
fi

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
require_live_layout
for command in chroot env find findmnt mount mktemp python3 realpath savechanges umount; do
    command -v "$command" >/dev/null 2>&1 || {
        echo "Required command not found: $command" >&2
        exit 1
    }
done
CHROOT_BIN=$(command -v chroot)
ENV_BIN=$(command -v env)

machine_phase prepare
prepare_local_packages
build_lowers

if [[ -d $SYSTEMCHANGES/changes && -d $SYSTEMCHANGES/workdir ]] &&
   [[ -z $(find "$SYSTEMCHANGES" -mindepth 1 -maxdepth 1 ! -name changes ! -name workdir -print -quit) ]]; then
    TMP=$(mktemp -d "$SYSTEMCHANGES/build2sb.XXXXX")
else
    mkdir -p -- "$SYSTEMCHANGES/tmp"
    TMP=$(mktemp -d "$SYSTEMCHANGES/tmp/build2sb.XXXXX")
fi
CHANGES=$TMP/changes
UNION=$TMP/union
[[ $JSON_OUTPUT == false ]] || SAVECHANGES_JSON=$TMP/savechanges.ndjson
trap cleanup EXIT

mkdir -p -- "$CHANGES" "$UNION"

if aufs_is_supported; then
    mount -t aufs -o "br=$CHANGES=rw:$LOWERS" none "$UNION"
    AUFS_BRANCHES=$TMP/aufs-branches
    write_aufs_branch_inventory "$AUFS_BRANCHES" "$CHANGES" "$LOWERS"
    AUFS_BRANCH_ARGS=(--aufs-branches "$AUFS_BRANCHES")
else
    AUFS_BRANCH_ARGS=()
    mkdir -p -- "$TMP/work"
    mount -t overlay overlay -o lowerdir="$LOWERS",upperdir="$CHANGES",workdir="$TMP/work" "$UNION"
fi

for dir in boot dev proc sys tmp media mnt run; do
    mkdir -p -- "$UNION/$dir"
done
chmod 1777 "$UNION/tmp"

for dir in dev dev/pts proc sys; do
    mount --bind "/$dir" "$UNION/$dir"
done

if [[ -e $CHANGES/etc/resolv.conf || -L $CHANGES/etc/resolv.conf ]]; then
    RESOLV_BACKUP=$TMP/resolv.conf.backup
    cp -a -- "$CHANGES/etc/resolv.conf" "$RESOLV_BACKUP"
    RESOLV_HAD_UPPER=true
fi
mkdir -p -- "$UNION/etc"
rm -f -- "$UNION/etc/resolv.conf"
cp -L -- /etc/resolv.conf "$UNION/etc/resolv.conf"
chmod 0644 "$UNION/etc/resolv.conf"

if (( ${#LOCAL_PACKAGE_SOURCES[@]} > 0 )); then
    mkdir -p -- "$UNION/tmp/apt2sb-packages"
    for (( i=0; i<${#LOCAL_PACKAGE_SOURCES[@]}; i++ )); do
        run_convert_engine copy-input \
            "${LOCAL_PACKAGE_SOURCES[$i]}" \
            "$UNION${LOCAL_PACKAGE_DESTS[$i]}" "${PKEXEC_UID:-}" || {
            echo "Cannot copy local package as the invoking user: ${LOCAL_PACKAGE_SOURCES[$i]}" >&2
            exit 1
        }
    done
fi

CHROOT_ENV=("$ENV_BIN" -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C)
machine_phase update
print_command apt-get update
if ! run_visible "$CHROOT_BIN" "$UNION" "${CHROOT_ENV[@]}" apt-get update; then
    FAILED=true
else
    machine_phase packages
    print_command apt-get "$APT_COMMAND" "${APT_OPTIONS[@]}" "${PACKAGE_ARGS[@]}"
    if ! run_visible "$CHROOT_BIN" "$UNION" "${CHROOT_ENV[@]}" \
            apt-get "$APT_COMMAND" "${APT_OPTIONS[@]}" "${PACKAGE_ARGS[@]}"; then
        FAILED=true
    else
        FAILED=false
    fi
fi

if ! detach_chroot_mounts; then
    echo "Failed to unmount one or more chroot filesystems; no module was created." >&2
    exit 1
fi

restore_resolv_conf
rm -rf -- "$CHANGES/tmp/apt2sb-packages" 2>/dev/null || true
rmdir "$CHANGES/tmp" 2>/dev/null || true
rmdir "$CHANGES"/* 2>/dev/null || true

if [[ $FAILED == false ]]; then
    if [[ -z $FILENAME ]]; then
        if [[ $APT_COMMAND == upgrade ]]; then
            FILENAME="upgrade.$BEXT"
        else
            FILENAME="${PACKAGES[0]##*/}.$BEXT"
        fi
        if [[ -n $FILTER_LEVEL ]]; then
            PREFIX="$(printf '%02d' "$((10#$FILTER_LEVEL + 1))")-"
        else
            PREFIX=""
        fi
        FILENAME="$PREFIX$FILENAME"
    fi

    message "Saving changes made by installing packages into a module $FILENAME..."
    machine_phase capture
    if [[ $JSON_OUTPUT == true ]]; then
        if ! savechanges --json --mounted-root "$UNION" "${AUFS_BRANCH_ARGS[@]}" \
                "$FILENAME" "$CHANGES" -c "$COMP_TYPE" >"$SAVECHANGES_JSON"; then
            echo "Module capture failed; no apt2sb result was published." >&2
            exit 1
        fi
        if ! APT_RESULT=$(run_protocol apt2sb-result "$APT_COMMAND" "$COMP_TYPE" \
                "${#PACKAGES[@]}" "$SAVECHANGES_JSON"); then
            echo "Cannot construct apt2sb result from savechanges output." >&2
            exit 1
        fi
        if ! safe_umount "$UNION"; then
            echo "Cannot unmount the apt2sb build union; no result was published." >&2
            exit 1
        fi
        UNION=""
        if has_mounts_under "$TMP" || ! rm -rf -- "$TMP"; then
            echo "Cannot clean the apt2sb workspace; no result was published." >&2
            exit 1
        fi
        TMP=""
        machine_phase complete
        printf '%s\n' "$APT_RESULT"
    else
        savechanges --mounted-root "$UNION" "${AUFS_BRANCH_ARGS[@]}" \
            "$FILENAME" "$CHANGES" -c "$COMP_TYPE"
    fi
else
    echo "Package operation failed; no module was created." >&2
    exit 1
fi
