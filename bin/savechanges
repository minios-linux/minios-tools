#!/bin/bash
# Author: Tomas M. <http://www.slax.org/>
# Author: crims0n <https://minios.dev>

VERSION="1.0.1"
BEXT="sb"
COMP_TYPE="zstd"
export TEXTDOMAIN="minios-tools"
TMP=/tmp/changes$$
EXCLUDE="^\$|/\$|[.]wh[.][.]wh[.]orph/|^[.]wh[.][.]pwd[.]lock|^[.]wh[.][.]wh[.]plnk/|^[.]wh[.][.]wh[.]aufs|^var/cache/|^var/backups/|^var/tmp/|^var/log/|^var/lib/apt/|^var/lib/dhcp/|^var/lib/systemd/|^sbin/fsck[.]aufs|^etc/resolv[.]conf|^root/[.]Xauthority|^root/[.]xsession-errors|^root/[.]fehbg|^root/[.]fluxbox/lastwallpaper|^root/[.]fluxbox/menu_resolution|^etc/mtab|^etc/fstab|^boot/|^dev/|^mnt/|^proc/|^run/|^sys/|^tmp/"

# Detect initramfs type and set default changes path
if [ -d "/run/initramfs/memory/changes" ]; then
    # livekit initramfs
    CHANGES=/run/initramfs/memory/changes
elif [ -d "/lib/live/mount/changes" ]; then
    # dracut initramfs
    CHANGES=/lib/live/mount/changes
fi

help() {
   echo "$(gettext "Usage"): $(basename $0) [OPTIONS] target_file.$BEXT [changes_directory]"
   echo "$(gettext "Saves all changed files in a compressed filesystem bundle.")"
   echo ""
   echo "$(gettext "Options"):"
   echo "  -c, --comp TYPE        $(gettext "Compression type (zstd, gzip, lzo, xz). Default: zstd")"
   echo "  -b, --bext EXT         $(gettext "Bundle extension. Default: sb")"
   echo "      --help             $(gettext "Display this help and exit")"
   echo "      --version          $(gettext "Display version information and exit")"
   echo ""
   echo "$(gettext "If changes_directory is not specified, the default changes")"
   echo "$(gettext "directory from the current initramfs is used.")"
   echo ""
   exit 0
}

brief_help() {
   echo "$(gettext "Usage"): $(basename $0) [OPTIONS] target_file.$BEXT [changes_directory]"
   echo "$(gettext "Try") '$(basename $0) --help' $(gettext "for more information.")"
   exit 1
}

version() {
   echo "$(basename $0) $VERSION"
   exit 0
}

while [[ $# -gt 0 ]]; do
   key="$1"

   case $key in
   -c | --comp)
      COMP_TYPE="$2"
      shift 2
      ;;
   -b | --bext)
      BEXT="$2"
      shift 2
      ;;
   --help)
      help
      ;;
   --version)
      version
      ;;
   *) # unknown option
      TARGET="$1"
      shift
      if [[ $# -gt 0 ]]; then
         CHANGES="$1"
         shift
      fi
      ;;
   esac
done

if [[ "$(id -u)" != "0" ]]; then
   echo "This script must be run as root." >&2
   brief_help
fi

if [[ -z "$TARGET" ]]; then
   brief_help
fi

# Overlayfs requires one more subdir. Detect it this way
if [ -d "$CHANGES/changes" ] && [ -d "$CHANGES/workdir" ] && [ "$(ls -1 "$CHANGES" | egrep -v '^changes$' | egrep -v '^workdir')" = "" ]; then
   CHANGES="$CHANGES/changes"
fi

# exclude control files for automounted disk drives
EXCLUDEDISKS=$(grep "Skip savechanges" /etc/systemd/system/{*,*/*} 2>/dev/null | cut -d : -f 1 | cut -b 2- | tr '\n' '|')
if [ -n "$EXCLUDEDISKS" ]; then
   EXCLUDE="$EXCLUDE|^($EXCLUDEDISKS)\$"
fi

# exclude the save_file itself of course
EXCLUDE="$EXCLUDE|^$(readlink -f "$TARGET" | cut -b 2- | sed -r "s/[.]/[.]/")\$"

CWD=$(pwd)

cleanup() {
   if grep -qs " $TMP " /proc/mounts; then
      umount "$TMP" 2>/dev/null || true
   fi
   if [ -d "$TMP" ]; then
      rmdir "$TMP" 2>/dev/null || true
   fi
}

# squashfs-tools 4.3 (e.g. Ubuntu bionic) lacks -quiet and requires a lowercase block-size suffix.
# squashfs-tools 4.7+ added -help-option; use it when available.
# We use -quiet presence as a proxy for uppercase block-size support: 4.3 lacks both,
# while 4.4+ provides both; an unusual build with only one trait is not expected.
mksquashfs_supports_quiet() {
   local help
   help=$(mksquashfs -help-option quiet 2>&1 || true)
   if echo "$help" | grep -qE '^-quiet'; then
      return 0
   fi
   help=$(mksquashfs 2>&1 || true)
   echo "$help" | grep -qE '^-quiet[[:space:]]'
}

if mksquashfs_supports_quiet; then
   MKSQUASHFS_QUIET=1
else
   MKSQUASHFS_QUIET=0
fi

trap cleanup EXIT INT TERM

cd "$CHANGES" || exit

mkdir -p "$TMP"
mount -t tmpfs tmpfs "$TMP"

find \( -type d -printf "%p/\n" , -not -type d -print \) |
   sed -r "s/^[.]\\///" | egrep -v "$EXCLUDE" |
   while read FILE; do
      cp --parents -afr "$FILE" "$TMP"
   done

cd "$CWD"

if [ "$COMP_TYPE" = "zstd" ]; then
   COMP_OPTS="-Xcompression-level 19"
elif [ "$COMP_TYPE" = "xz" ]; then
   COMP_OPTS="-Xbcj x86"
else
   COMP_OPTS=""
fi

if [ "$MKSQUASHFS_QUIET" = 1 ]; then
   if ! mksquashfs "$TMP" "$TARGET" -comp "$COMP_TYPE" -b 1024K -always-use-fragments -noappend -quiet $COMP_OPTS; then
      echo "Failed to create module: mksquashfs error (compression: $COMP_TYPE)." >&2
      exit 1
   fi
else
   if ! mksquashfs "$TMP" "$TARGET" -comp "$COMP_TYPE" -b 1024k -always-use-fragments -noappend $COMP_OPTS >/dev/null 2>&1; then
      echo "Failed to create module: mksquashfs error (compression: $COMP_TYPE)." >&2
      exit 1
   fi
fi
