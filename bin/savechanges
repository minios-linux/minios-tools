#!/bin/bash
# shellcheck disable=SC2317
# Author: Tomas M. <http://www.slax.org/>
# Author: crims0n <https://minios.dev>

set -Eeuo pipefail

VERSION="1.3.0"
BEXT="sb"
COMP_TYPE="zstd"
export TEXTDOMAIN="minios-tools"

PROGRAM_NAME=${0##*/}
START_DIR=$(pwd -P)
PROFILE=""
PROFILE_SET=false
SELECTION_INPUT=""
SELECTION_SET=false
INVENTORY_INPUT=""
INVENTORY_SET=false
METADATA_INPUT=""
METADATA_SET=false
CANCEL_INPUT=""
CANCEL_SET=false
DISABLE_COLOR=false
JSON_MODE=false
WORK_PARENT_INPUT=""
WORK_PARENT_SET=false
CHILD_PID=""
TEST_MODE=false
MOUNTINFO_PATH=/proc/self/mountinfo
CMDLINE_PATH=/proc/cmdline
BOOT_ID_PATH=/proc/sys/kernel/random/boot_id
RUNNING_SOURCE_PATH=""

RED=""
BOLD=""
ENDCOLOR=""

declare -a POSITIONAL=()

help() {
    printf '%s: %s [OPTIONS] TARGET.%s [CHANGES_DIRECTORY]\n' "$(gettext "Usage")" "$PROGRAM_NAME" "$BEXT"
    printf '       %s [OPTIONS] --inventory-json FILE [CHANGES_DIRECTORY]\n' "$PROGRAM_NAME"
    printf '%s\n\n' "$(gettext "Capture the writable layer of a running MiniOS session.")"
    printf '%s:\n' "$(gettext "Options")"
    printf '  -c, --comp TYPE          %s\n' "$(gettext "Compression: zstd, gzip, lzo, or xz (default: zstd)")"
    printf '  -b, --bext EXT           %s\n' "$(gettext "Bundle extension used in help text (default: sb)")"
    printf '      --profile PROFILE    %s\n' "$(gettext "Capture profile: exact, clean, or selected")"
    printf '      --selection FILE     %s\n' "$(gettext "Strict JSON selection for the selected profile")"
    printf '      --inventory-json FILE\n'
    printf '                            %s\n' "$(gettext "Write a metadata inventory instead of a module")"
    printf '      --metadata-json FILE %s\n' "$(gettext "Write capture metadata beside a module")"
    printf '      --work-parent DIR    %s\n' "$(gettext "Use a validated directory for private capture staging")"
    printf '      --json               %s\n' "$(gettext "Emit pure NDJSON phase and result events")"
    printf '      --cancel-file FILE   %s\n' "$(gettext "Cancel when FILE is created in its secure parent directory")"
    printf '      --no-color           %s\n' "$(gettext "Disable colored output")"
    printf '      --help               %s\n' "$(gettext "Display this help and exit")"
    printf '      --version            %s\n\n' "$(gettext "Display version information and exit")"
    printf '%s\n' "$(gettext "Without --profile, the historical exclusion policy is used.")"
    printf '%s\n' "$(gettext "New profiles and inventories are published mode 0600.")"
}

brief_help() {
    printf '%s: %s [OPTIONS] TARGET.%s [CHANGES_DIRECTORY]\n' "$(gettext "Usage")" "$PROGRAM_NAME" "$BEXT" >&2
    printf "%s '%s --help' %s\n" "$(gettext "Try")" "$PROGRAM_NAME" "$(gettext "for more information.")" >&2
}

version() {
    printf '%s %s\n' "$PROGRAM_NAME" "$VERSION"
}

console_colors() {
    if [[ $DISABLE_COLOR == false && -z ${NO_COLOR:-} &&
          ( ${OUTPUT_MODE:-} == "console" || -t 1 ) ]]; then
        RED=$'\e[31m'
        BOLD=$'\e[1m'
        ENDCOLOR=$'\e[0m'
    fi
}

error() {
    printf '%s%sE:%s %s\n' "$BOLD" "$RED" "$ENDCOLOR" "$*" >&2
}

die() {
    local status=$1
    shift
    error "$*"
    exit "$status"
}

brief_option_error() {
    error "$*"
    brief_help
    exit 1
}

require_value() {
    (( $2 >= 2 )) || brief_option_error "$(gettext "Option requires an argument:") $1"
}

contains_line_break() {
    [[ $1 == *$'\n'* || $1 == *$'\r'* ]]
}

validate_no_line_break() {
    contains_line_break "$2" && die 1 "$1 $(gettext "must not contain newline characters")"
    return 0
}

cleanup() {
    local status=$?
    trap - EXIT
    trap '' INT TERM
    if [[ -n $CHILD_PID ]] && kill -0 "$CHILD_PID" 2>/dev/null; then
        kill -TERM -- "-$CHILD_PID" 2>/dev/null || kill -TERM "$CHILD_PID" 2>/dev/null || true
        wait "$CHILD_PID" 2>/dev/null || true
    fi
    exit "$status"
}

handle_signal() {
    trap '' INT TERM
    if [[ -n $CHILD_PID ]] && kill -0 "$CHILD_PID" 2>/dev/null; then
        kill -TERM -- "-$CHILD_PID" 2>/dev/null || kill -TERM "$CHILD_PID" 2>/dev/null || true
        for _ in {1..200}; do
            kill -0 "$CHILD_PID" 2>/dev/null || break
            sleep 0.05
        done
        if kill -0 "$CHILD_PID" 2>/dev/null; then
            kill -KILL -- "-$CHILD_PID" 2>/dev/null || kill -KILL "$CHILD_PID" 2>/dev/null || true
        fi
        wait "$CHILD_PID" 2>/dev/null || true
        CHILD_PID=""
    fi
    exit 130
}

trap cleanup EXIT
trap handle_signal INT TERM

json_requested=false
query_requested=false
for argument in "$@"; do
    [[ $argument != --json ]] || json_requested=true
    [[ $argument != --help && $argument != --version ]] || query_requested=true
done
if [[ $json_requested == true && $query_requested == true ]]; then
    printf 'E: %s\n' "$(gettext "--json cannot be combined with --help or --version")" >&2
    exit 1
fi

while (( $# > 0 )); do
    case $1 in
    -c | --comp)
        require_value "$1" "$#"
        COMP_TYPE=$2
        shift 2
        ;;
    --comp=*) COMP_TYPE=${1#*=}; shift ;;
    -b | --bext)
        require_value "$1" "$#"
        BEXT=$2
        shift 2
        ;;
    --bext=*) BEXT=${1#*=}; shift ;;
    --profile)
        require_value "$1" "$#"
        PROFILE_SET=true
        PROFILE=$2
        shift 2
        ;;
    --profile=*) PROFILE_SET=true; PROFILE=${1#*=}; shift ;;
    --selection)
        require_value "$1" "$#"
        SELECTION_SET=true
        SELECTION_INPUT=$2
        shift 2
        ;;
    --selection=*) SELECTION_SET=true; SELECTION_INPUT=${1#*=}; shift ;;
    --inventory-json)
        require_value "$1" "$#"
        INVENTORY_SET=true
        INVENTORY_INPUT=$2
        shift 2
        ;;
    --inventory-json=*) INVENTORY_SET=true; INVENTORY_INPUT=${1#*=}; shift ;;
    --metadata-json)
        require_value "$1" "$#"
        METADATA_SET=true
        METADATA_INPUT=$2
        shift 2
        ;;
    --metadata-json=*) METADATA_SET=true; METADATA_INPUT=${1#*=}; shift ;;
    --work-parent)
        require_value "$1" "$#"
        WORK_PARENT_SET=true
        WORK_PARENT_INPUT=$2
        shift 2
        ;;
    --work-parent=*) WORK_PARENT_SET=true; WORK_PARENT_INPUT=${1#*=}; shift ;;
    --cancel-file)
        require_value "$1" "$#"
        CANCEL_SET=true
        CANCEL_INPUT=$2
        shift 2
        ;;
    --cancel-file=*) CANCEL_SET=true; CANCEL_INPUT=${1#*=}; shift ;;
    --no-color) DISABLE_COLOR=true; shift ;;
    --json) JSON_MODE=true; DISABLE_COLOR=true; shift ;;
    --help) help; exit 0 ;;
    --version) version; exit 0 ;;
    --)
        shift
        POSITIONAL+=("$@")
        break
        ;;
    -*) brief_option_error "$(gettext "Unknown option:") $1" ;;
    *) POSITIONAL+=("$1"); shift ;;
    esac
done

console_colors

if [[ $PROFILE_SET == false ]]; then
    PROFILE=legacy
fi
case $PROFILE in
legacy | exact | clean | selected) ;;
*) die 1 "$(gettext "Invalid capture profile:") $PROFILE" ;;
esac
[[ ! ( $PROFILE == legacy && $PROFILE_SET == true ) ]] ||
    die 1 "$(gettext "Invalid capture profile:") $PROFILE"
[[ $PROFILE != selected || $SELECTION_SET == true ]] ||
    die 1 "$(gettext "The selected profile requires --selection")"
[[ $PROFILE == selected || $SELECTION_SET != true ]] ||
    die 1 "$(gettext "--selection is only valid with --profile selected")"
case $COMP_TYPE in
zstd | gzip | lzo | xz) ;;
*) die 1 "$(gettext "Invalid compression type:") $COMP_TYPE" ;;
esac
[[ $BEXT =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] ||
    die 1 "$(gettext "Invalid bundle extension:") $BEXT"

if [[ $INVENTORY_SET == true ]]; then
    (( ${#POSITIONAL[@]} <= 1 )) || die 1 "$(gettext "Inventory mode accepts at most one changes directory")"
    [[ $METADATA_SET != true ]] || die 1 "$(gettext "--metadata-json is not valid in inventory mode")"
    MODE=inventory
    OUTPUT_INPUT=$INVENTORY_INPUT
    CHANGES_INPUT=${POSITIONAL[0]:-}
else
    (( ${#POSITIONAL[@]} >= 1 && ${#POSITIONAL[@]} <= 2 )) || {
        brief_help
        exit 1
    }
    MODE=module
    OUTPUT_INPUT=${POSITIONAL[0]}
    CHANGES_INPUT=${POSITIONAL[1]:-}
fi

[[ -n $OUTPUT_INPUT && $OUTPUT_INPUT != */ ]] || die 1 "$(gettext "Invalid output filename")"
validate_no_line_break "$(gettext "Output path")" "$OUTPUT_INPUT"
validate_no_line_break "$(gettext "Changes directory")" "$CHANGES_INPUT"
if [[ $SELECTION_SET == true ]]; then
    validate_no_line_break "$(gettext "Selection path")" "$SELECTION_INPUT"
fi
if [[ $METADATA_SET == true ]]; then
    [[ -n $METADATA_INPUT && $METADATA_INPUT != */ ]] || die 1 "$(gettext "Invalid metadata output filename")"
    validate_no_line_break "$(gettext "Metadata output path")" "$METADATA_INPUT"
fi
if [[ $CANCEL_SET == true ]]; then
    [[ -n $CANCEL_INPUT && $CANCEL_INPUT != */ ]] || die 1 "$(gettext "Invalid cancel marker filename")"
    validate_no_line_break "$(gettext "Cancel marker path")" "$CANCEL_INPUT"
fi
if [[ $WORK_PARENT_SET == true ]]; then
    [[ -n $WORK_PARENT_INPUT && $WORK_PARENT_INPUT != */ ]] || die 1 "$(gettext "Invalid work parent")"
    validate_no_line_break "$(gettext "Work parent")" "$WORK_PARENT_INPUT"
fi

if [[ -z $CHANGES_INPUT ]]; then
    if [[ -d /run/initramfs/memory/changes ]]; then
        CHANGES_INPUT=/run/initramfs/memory/changes
    elif [[ -d /lib/live/mount/changes ]]; then
        CHANGES_INPUT=/lib/live/mount/changes
    fi
fi

SCRIPT_PATH=$(/bin/readlink -f -- "${BASH_SOURCE[0]}") || die 1 "$(gettext "Cannot resolve script path")"
SOURCE_TEST_MARKER=${SCRIPT_PATH%/*}/../tests/.source-test-context
if (( EUID != 0 )) && [[ ${MINIOS_TOOLS_TEST_ALLOW_NON_ROOT:-0} == 1 &&
      -n ${MINIOS_TOOLS_TEST_ROOT:-} && -f $SOURCE_TEST_MARKER && ! -L $SOURCE_TEST_MARKER &&
      $(<"$SOURCE_TEST_MARKER") == minios-tools-source-test-v1 ]]; then
    TEST_MODE=true
fi
if (( EUID != 0 )) && [[ $TEST_MODE != true ]]; then
    die 1 "$(gettext "This script must be run as root.")"
fi
[[ -n $CHANGES_INPUT ]] || die 2 "$(gettext "Cannot detect the live writable changes directory")"

absolute_path() {
    if [[ $1 == /* ]]; then
        printf '%s\n' "$1"
    else
        printf '%s/%s\n' "$START_DIR" "$1"
    fi
}

OUTPUT_PATH=$(absolute_path "$OUTPUT_INPUT")
CHANGES_PATH=$(absolute_path "$CHANGES_INPUT")
SELECTION_PATH=""
METADATA_PATH=""
CANCEL_PATH=""
WORK_PARENT_PATH=""
[[ $SELECTION_SET != true ]] || SELECTION_PATH=$(absolute_path "$SELECTION_INPUT")
[[ $METADATA_SET != true ]] || METADATA_PATH=$(absolute_path "$METADATA_INPUT")
[[ $CANCEL_SET != true ]] || CANCEL_PATH=$(absolute_path "$CANCEL_INPUT")
[[ $WORK_PARENT_SET != true ]] || WORK_PARENT_PATH=$(absolute_path "$WORK_PARENT_INPUT")

trusted_executable() {
    local requested=$1
    local resolved owner mode
    [[ -e $requested ]] || return 1
    resolved=$(/bin/readlink -f -- "$requested") || return 1
    [[ -f $resolved && -x $resolved ]] || return 1
    read -r owner mode < <(/usr/bin/stat -c '%u %a' -- "$resolved") || return 1
    [[ $owner == 0 && $mode =~ ^[0-7]+$ ]] || return 1
    (( (8#$mode & 0022) == 0 )) || return 1
    printf '%s\n' "$resolved"
}

PYTHON_BIN=$(trusted_executable /usr/bin/python3) || die 1 "$(gettext "Trusted /usr/bin/python3 is unavailable")"
ENV_BIN=$(trusted_executable /usr/bin/env) || die 1 "$(gettext "Trusted /usr/bin/env is unavailable")"

if [[ $TEST_MODE == true ]]; then
    test_root=$(/usr/bin/realpath -e -- "${MINIOS_TOOLS_TEST_ROOT}") || die 1 "$(gettext "Invalid test root")"
    path_in_test_root() {
        local candidate=$1
        [[ $candidate == "$test_root" || $candidate == "$test_root"/* ]]
    }
    changes_test=$(/usr/bin/realpath -e -- "$CHANGES_PATH") || die 1 "$(gettext "Invalid test changes directory")"
    output_parent_input=${OUTPUT_PATH%/*}
    [[ -n $output_parent_input ]] || output_parent_input=/
    output_parent_test=$(/usr/bin/realpath -e -- "$output_parent_input") || die 1 "$(gettext "Invalid test output parent")"
    if ! path_in_test_root "$changes_test" || ! path_in_test_root "$output_parent_test"; then
        die 1 "$(gettext "Non-root test capture is confined to MINIOS_TOOLS_TEST_ROOT")"
    fi
    if [[ -n $SELECTION_PATH ]]; then
        selection_test=$(/usr/bin/realpath -e -- "$SELECTION_PATH") || die 1 "$(gettext "Invalid test selection")"
        path_in_test_root "$selection_test" || die 1 "$(gettext "Test selection is outside the test root")"
    fi
    if [[ -n $METADATA_PATH ]]; then
        metadata_parent_input=${METADATA_PATH%/*}
        [[ -n $metadata_parent_input ]] || metadata_parent_input=/
        metadata_parent_test=$(/usr/bin/realpath -e -- "$metadata_parent_input") || die 1 "$(gettext "Invalid test metadata parent")"
        path_in_test_root "$metadata_parent_test" || die 1 "$(gettext "Test metadata output is outside the test root")"
    fi
    if [[ -n $CANCEL_PATH ]]; then
        cancel_parent_input=${CANCEL_PATH%/*}
        [[ -n $cancel_parent_input ]] || cancel_parent_input=/
        cancel_parent_test=$(/usr/bin/realpath -e -- "$cancel_parent_input") ||
            die 1 "$(gettext "Invalid test cancel marker parent")"
        path_in_test_root "$cancel_parent_test" ||
            die 1 "$(gettext "Test cancel marker is outside the test root")"
    fi
    if [[ -n $WORK_PARENT_PATH ]]; then
        work_parent_test=$(/usr/bin/realpath -e -- "$WORK_PARENT_PATH") ||
            die 1 "$(gettext "Invalid test work parent")"
        path_in_test_root "$work_parent_test" ||
            die 1 "$(gettext "Test work parent is outside the test root")"
        TEMP_PARENT=$WORK_PARENT_PATH
    else
        TEMP_PARENT=${TMPDIR:-$test_root}
    fi
    MKSQUASHFS_BIN=${MINIOS_TOOLS_TEST_MKSQUASHFS:-}
    UNSQUASHFS_BIN=${MINIOS_TOOLS_TEST_UNSQUASHFS:-}
    if [[ $MODE == module ]]; then
        [[ -n $MKSQUASHFS_BIN && -n $UNSQUASHFS_BIN ]] || die 1 "$(gettext "Test capture tools were not provided")"
        mks_test=$(/usr/bin/realpath -e -- "$MKSQUASHFS_BIN") || die 1 "$(gettext "Invalid test mksquashfs")"
        unsquash_test=$(/usr/bin/realpath -e -- "$UNSQUASHFS_BIN") || die 1 "$(gettext "Invalid test unsquashfs")"
        if ! path_in_test_root "$mks_test" || ! path_in_test_root "$unsquash_test"; then
            die 1 "$(gettext "Test tools are outside the test root")"
        fi
    fi
    MOUNTINFO_PATH=${MINIOS_TOOLS_TEST_MOUNTINFO:-}
    CMDLINE_PATH=${MINIOS_TOOLS_TEST_CMDLINE:-}
    BOOT_ID_PATH=${MINIOS_TOOLS_TEST_BOOT_ID:-}
    RUNNING_SOURCE_PATH=${MINIOS_TOOLS_TEST_RUNNING_SOURCE:-}
    for fixture_path in "$MOUNTINFO_PATH" "$CMDLINE_PATH" "$BOOT_ID_PATH"; do
        [[ -n $fixture_path && ! -L $fixture_path && -f $fixture_path ]] ||
            die 1 "$(gettext "Invalid source-test fixture")"
        fixture_path=$(/usr/bin/realpath -e -- "$fixture_path") ||
            die 1 "$(gettext "Cannot canonicalize source-test fixture")"
        path_in_test_root "$fixture_path" || die 1 "$(gettext "Source-test fixture is outside the test root")"
    done
    if [[ -n $RUNNING_SOURCE_PATH ]]; then
        running_source_test=$(/usr/bin/realpath -e -- "$RUNNING_SOURCE_PATH") ||
            die 1 "$(gettext "Invalid source-test running source")"
        path_in_test_root "$running_source_test" ||
            die 1 "$(gettext "Source-test running source is outside the test root")"
        RUNNING_SOURCE_PATH=$running_source_test
    fi
else
    TEMP_PARENT=${WORK_PARENT_PATH:-/tmp}
    MKSQUASHFS_BIN=/usr/bin/mksquashfs
    UNSQUASHFS_BIN=/usr/bin/unsquashfs
fi

OWNER_UID=${PKEXEC_UID:-}
[[ -z $OWNER_UID || $OWNER_UID =~ ^[0-9]+$ ]] || die 1 "$(gettext "Invalid PKEXEC_UID")"

SAVECHANGES_ENGINE=""
for engine_candidate in \
    "${SCRIPT_PATH%/*}/../lib/minios_savechanges_engine.py" \
    /usr/lib/minios-tools/minios_savechanges_engine.py; do
    if [[ -f $engine_candidate ]]; then
        SAVECHANGES_ENGINE=$(/bin/readlink -f -- "$engine_candidate") || true
        [[ -n $SAVECHANGES_ENGINE ]] && break
    fi
done
[[ -n $SAVECHANGES_ENGINE ]] || die 1 "$(gettext "savechanges engine helper not found")"

declare -a ENGINE_ENV=(
    PATH=/usr/sbin:/usr/bin:/sbin:/bin
    LC_ALL=C.UTF-8
    LANG=C.UTF-8
)
if [[ $TEST_MODE == true ]]; then
    for test_name in MKSQUASHFS_STATE MKSQUASHFS_FAIL MKSQUASHFS_RACE_TARGET \
        MKSQUASHFS_SLEEP MKSQUASHFS_SLEEP_MARKER MKSQUASHFS_STUBBORN \
        MKSQUASHFS_LEADER_EXIT MKSQUASHFS_NO_QUIET \
        UNSQUASHFS_FAIL_PATTERN SAVECHANGES_TEST_PAUSE_BEFORE_COPY \
        SAVECHANGES_TEST_FAIL_OUTPUT_DIR_FSYNC SAVECHANGES_TEST_PAUSE_AFTER_PUBLISH \
        SAVECHANGES_TEST_XATTR_EPERM SAVECHANGES_TEST_METADATA_NOOP; do
        [[ -z ${!test_name+x} ]] || ENGINE_ENV+=("$test_name=${!test_name}")
    done
fi

exec "$ENV_BIN" -i "${ENGINE_ENV[@]}" "$PYTHON_BIN" -I "$SAVECHANGES_ENGINE" \
    execute "$MODE" "$PROFILE" "$COMP_TYPE" "$OUTPUT_PATH" "$CHANGES_PATH" \
    "$SELECTION_PATH" "$METADATA_PATH" "$TEMP_PARENT" "$OWNER_UID" \
    "$([[ $TEST_MODE == true ]] && printf 1 || printf 0)" "$MKSQUASHFS_BIN" \
    "$UNSQUASHFS_BIN" "$MOUNTINFO_PATH" "$CMDLINE_PATH" "$BOOT_ID_PATH" \
    "$RUNNING_SOURCE_PATH" "$CANCEL_PATH" "$([[ $JSON_MODE == true ]] && printf 1 || printf 0)"
