#!/bin/bash
# Author: Tomas M. <http://www.slax.org/>
# Author: crims0n <https://minios.dev>

VERSION="1.1.0"

usage() {
   printf '%s\n' "Refuse unsafe removal of a directory created by sb2dir"
   printf 'Usage: %s [--help|--version] source_directory.sb\n' "${0##*/}"
}

case "${1-}" in
   -h|--help)
      usage
      exit 0
      ;;
   --version)
      printf '%s %s\n' "${0##*/}" "$VERSION"
      exit 0
      ;;
   --)
      shift
      ;;
   -*)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
esac

if [ "$#" -ne 1 ]; then
   usage >&2
   exit 1
fi

printf '%s\n' "rmsbdir no longer removes unpacked module directories." >&2
printf '%s\n' "Review the path, then remove the ordinary directory with standard filesystem tools." >&2
exit 1
