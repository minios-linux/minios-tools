#!/bin/bash
set -Eeuo pipefail

SCRIPT_PATH=$(/bin/readlink -f -- "$0")
PYTHON_BIN=/usr/bin/python3
CLI=""
for candidate in \
    "${SCRIPT_PATH%/*}/../lib/minios_squashfs_cli.py" \
    "${SCRIPT_PATH%/*}/../lib/minios-tools/minios_squashfs_cli.py" \
    /usr/lib/minios-tools/minios_squashfs_cli.py; do
    if [[ -f $candidate ]]; then
        CLI=$(/bin/readlink -f -- "$candidate") || true
        [[ -n $CLI ]] && break
    fi
done
[[ -n $CLI ]] || { printf 'E: SquashFS save helper not found\n' >&2; exit 1; }

exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C.UTF-8 LANG=C.UTF-8 \
    "$PYTHON_BIN" -I "$CLI" "$@"
