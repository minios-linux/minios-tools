msgid "Usage"
msgstr "Uso"

#: bin/apt2sb:21
msgid "Installs packages from repositories and packages them into a module."
msgstr "Instala pacotes de repositórios e os empacota em um módulo."

#: bin/apt2sb:23 bin/sb:34
msgid "Commands"
msgstr "Comandos"

#: bin/apt2sb:24
msgid "Install package(s)"
msgstr "Instalar pacote(s)"

#: bin/apt2sb:25
msgid "Upgrade installed packages"
msgstr "Atualizar pacotes instalados"

#: bin/apt2sb:27 bin/chroot2sb:22 bin/dir2sb:14 bin/savechanges:25
#: bin/sb2iso:29 bin/script2sb:23
msgid "Options"
msgstr "Opções"

#: bin/apt2sb:28
msgid "Use NAME as the filename for the module instead of PACKAGE1"
msgstr "Usar NOME como nome do arquivo para o módulo em vez de PACOTE1"

#: bin/apt2sb:29 bin/chroot2sb:25 bin/script2sb:28
msgid "Use LEVEL as the filter level"
msgstr "Usar NÍVEL como nível de filtro"

#: bin/apt2sb:30 bin/chroot2sb:26 bin/dir2sb:16 bin/savechanges:26
#: bin/script2sb:25
msgid "Compression type (zstd, gzip, lzo, xz). Default: zstd"
msgstr "Tipo de compressão (zstd, gzip, lzo, xz). Padrão: zstd"

#: bin/apt2sb:31 bin/chroot2sb:27 bin/dir2sb:15 bin/savechanges:27
#: bin/script2sb:24
msgid "Bundle extension. Default: sb"
msgstr "Extensão do pacote. Padrão: sb"

#: bin/apt2sb:32 bin/chroot2sb:28 bin/dir2sb:17 bin/savechanges:28 bin/sb:44
#: bin/sb2iso:35 bin/script2sb:30
msgid "Display this help and exit"
msgstr "Exibir esta ajuda e sair"

#: bin/apt2sb:33 bin/chroot2sb:29 bin/dir2sb:18 bin/savechanges:29 bin/sb:45
#: bin/sb2iso:36 bin/script2sb:31
msgid "Display version information and exit"
msgstr "Exibir informações de versão e sair"

#: bin/apt2sb:35
msgid "Apt Options (for install/upgrade command)"
msgstr "Opções do Apt (para comando de instalação/atualização)"

#: bin/apt2sb:36
msgid "Automatic yes to prompts"
msgstr "Sim automático para as perguntas"

#: bin/apt2sb:37
msgid "Allow downgrades of packages"
msgstr "Permitir downgrades de pacotes"

#: bin/apt2sb:38
msgid "Consider recommended packages as a dependency for installing"
msgstr "Considerar pacotes recomendados como dependência para instalação"

#: bin/apt2sb:39
msgid "Consider suggested packages as a dependency for installing"
msgstr "Considerar pacotes sugeridos como dependência para instalação"

#: bin/apt2sb:40
msgid "Do not consider recommended packages as a dependency for installing"
msgstr "Não considerar pacotes recomendados como dependência para instalação"

#: bin/apt2sb:41
msgid "Do not consider suggested packages as a dependency for installing"
msgstr "Não considerar pacotes sugeridos como dependência para instalação"

#: bin/apt2sb:42
msgid "Default release to install packages from"
msgstr "Lançamento padrão para instalar pacotes de"

#: bin/apt2sb:44 bin/chroot2sb:31 bin/sb:47 bin/sb2iso:38 bin/script2sb:33
msgid "Examples"
msgstr "Exemplos"

#: bin/apt2sb:54 bin/chroot2sb:40 bin/dir2sb:32 bin/savechanges:39 bin/sb:61
#: bin/sb2iso:56 bin/script2sb:43
msgid "Try"
msgstr "Tente"

#: bin/apt2sb:54 bin/chroot2sb:40 bin/dir2sb:32 bin/savechanges:39 bin/sb:61
#: bin/sb2iso:56 bin/script2sb:43
msgid "for more information."
msgstr "para mais informações."

#: bin/chroot2sb:20 bin/script2sb:21
msgid "Packages a module from changes made by an installation script"
msgstr "Empacota um módulo a partir de alterações feitas por um script de instalação"

#: bin/chroot2sb:23 bin/script2sb:26
msgid "Copy contents of DIR to the root of the module"
msgstr "Copiar conteúdo de DIR para a raiz do módulo"

#: bin/chroot2sb:24 bin/script2sb:27
msgid "Use NAME as the filename for the module"
msgstr "Usar NOME como nome do arquivo para o módulo"

#: bin/dir2sb:12
msgid "Converts a directory to a compressed .sb module"
msgstr "Converte um diretório em um módulo .sb compactado"

#: bin/dir2sb:20
msgid "Arguments"
msgstr "Argumentos"

#: bin/dir2sb:21
msgid "The directory to convert to a module"
msgstr "O diretório a ser convertido em um módulo"

#: bin/dir2sb:22
msgid "Optional. The name of the output module file"
msgstr "Opcional. O nome do arquivo do módulo de saída"

#: bin/dir2sb:24
msgid "Behavior"
msgstr "Comportamento"

#: bin/dir2sb:25
msgid "If SOURCE_DIRECTORY does not have a .sb extension and is not 'squashfs-root', then the directory itself is included in the module, and TARGET_FILE is required."
msgstr "Se DIRETÓRIO_DE_ORIGEM não tiver uma extensão .sb e não for 'squashfs-root', então o próprio diretório será incluído no módulo, e ARQUIVO_DE_DESTINO será exigido."

#: bin/dir2sb:26
msgid "If TARGET_FILE is not specified, SOURCE_DIRECTORY is replaced by the new module file."
msgstr "Se ARQUIVO_DE_DESTINO não for especificado, DIRETÓRIO_DE_ORIGEM será substituído pelo novo arquivo do módulo."

#: bin/rmsbdir:8
msgid "Erase module directory created by sb2dir"
msgstr "Apagar diretório de módulo criado por sb2dir"

#: bin/rmsbdir:9
msgid "source_directory.sb"
msgstr "diretorio_origem.sb"

#: bin/rmsbdir:18 bin/sb2dir:35
msgid "Directory does not exist:"
msgstr "Diretório não existe:"

#: bin/rmsbdir:25
msgid "Module directory deleted:"
msgstr "Diretório do módulo excluído:"

#: bin/savechanges:23
msgid "Saves all changed files in a compressed filesystem bundle."
msgstr "Salva todos os arquivos alterados em um pacote de sistema de arquivos compactado."

#: bin/savechanges:31
msgid "If changes_directory is not specified, the default changes"
msgstr "Se changes_directory não for especificado, as alterações padrão"

#: bin/savechanges:32
msgid "directory from the current initramfs is used."
msgstr "o diretório da initramfs atual será usado."

#: bin/sb:31
msgid "Manage MiniOS bundles."
msgstr "Gerenciar pacotes MiniOS."

#: bin/sb:32 bin/sb:60
msgid "To run some of the commands in this script, your Linux kernel must support AUFS."
msgstr "Para executar alguns dos comandos neste script, seu kernel Linux deve suportar AUFS."

#: bin/sb:35
msgid "Activate a MiniOS bundle"
msgstr "Ativar um pacote MiniOS"

#: bin/sb:36
msgid "Deactivate an active MiniOS bundle"
msgstr "Desativar um pacote MiniOS ativo"

#: bin/sb:37
msgid "List active MiniOS bundles"
msgstr "Listar pacotes MiniOS ativos"

#: bin/sb:38
msgid "Save changes made at runtime to the bundle"
msgstr "Salvar alterações feitas em tempo de execução no pacote"

#: bin/sb:40 bin/sb:41
msgid "Remove an unpacked bundle directory"
msgstr "Remover um diretório de pacote descompactado"

#: bin/sb:42
msgid "Convert an .sb bundle to directory or vice versa"
msgstr "Converter um pacote .sb para diretório ou vice-versa"

#: bin/sb2dir:9
msgid "Usage:"
msgstr "Uso:"

#: bin/sb2dir:10
msgid "If the output_directory is specified, it must exist"
msgstr "Se o diretório_de_saída for especificado, ele deve existir"

#: bin/sb2dir:11
msgid "If the output_directory is not specified, the name source_file.sb"
msgstr "Se o diretório_de_saída não for especificado, o nome arquivo_origem.sb"

#: bin/sb2dir:12
msgid "is used and the directory is overmounted with tmpfs"
msgstr "é usado e o diretório é sobremontado com tmpfs"

#: bin/sb2dir:17
msgid "File does not exist:"
msgstr "Arquivo não existe:"

