#: bin/sb:35
msgid "Manage MiniOS bundles."
msgstr "Управление пакетами MiniOS."

#: bin/sb:36 bin/sb:68
msgid "To run some of the commands in this script, your Linux kernel must support AUFS."
msgstr "Для выполнения некоторых команд из этого скрипта ядро Linux должно поддерживать AUFS."

#: bin/sb:39
msgid "Activate a MiniOS bundle"
msgstr "Активировать пакет MiniOS"

#: bin/sb:40
msgid "Deactivate an active MiniOS bundle"
msgstr "Деактивировать активный пакет MiniOS"

#: bin/sb:41
msgid "List active MiniOS bundles"
msgstr "Список активных пакетов MiniOS"

#: bin/sb:42
msgid "List modules selected for the next boot"
msgstr "Показать модули, выбранные для следующей загрузки"

#: bin/sb:43
msgid "Add a module to the next boot"
msgstr "Добавить модуль в следующую загрузку"

#: bin/sb:44
msgid "Remove a user module from the next boot"
msgstr "Удалить пользовательский модуль из следующей загрузки"

#: bin/sb:45
msgid "Inspect a SquashFS module without extracting it"
msgstr "Просмотреть модуль SquashFS без извлечения"

#: bin/sb:46
msgid "Save changes made at runtime to the bundle"
msgstr "Сохранить изменения, сделанные во время выполнения, в пакет"

