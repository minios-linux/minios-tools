#: bin/script2sb:30 bin/script2sb:54 bin/script2sb:57
msgid "Usage"
msgstr "Использование"

#: bin/apt2sb:34
msgid "Installs packages from repositories and packages them into a module."
msgstr "Устанавливает пакеты из репозиториев и упаковывает их в модуль."

#: bin/apt2sb:36 bin/sb:38
msgid "Commands"
msgstr "Команды"

#: bin/apt2sb:37
msgid "Install package(s)"
msgstr "Установить пакет(ы)"

#: bin/apt2sb:38
msgid "Upgrade installed packages"
msgstr "Обновить установленные пакеты"

#: bin/apt2sb:40 bin/chroot2sb:47 bin/dir2sb:38 bin/savechanges:50
#: bin/sb2dir:38 bin/script2sb:33
msgid "Options"
msgstr "Опции"

#: bin/apt2sb:41
msgid "Use NAME as the filename for the module instead of PACKAGE1"
msgstr "Использовать ИМЯ как имя файла для модуля вместо ПАКЕТ1"

#: bin/apt2sb:42 bin/chroot2sb:50 bin/script2sb:38
msgid "Use LEVEL as the filter level"
msgstr "Использовать УРОВЕНЬ в качестве уровня фильтрации"

#: bin/apt2sb:43 bin/chroot2sb:51 bin/script2sb:35
msgid "Compression type (zstd, gzip, lzo, lz4, xz). Default: zstd"
msgstr "Тип сжатия (zstd, gzip, lzo, lz4, xz). По умолчанию: zstd"

#: bin/apt2sb:44 bin/chroot2sb:52 bin/script2sb:34
msgid "Bundle extension. Default: sb"
msgstr "Расширение пакета. По умолчанию: sb"

#: bin/apt2sb:45 bin/script2sb:40
msgid "Emit machine-readable phase events and result"
msgstr "Выводить машиночитаемые события этапов и результат"

#: bin/apt2sb:46 bin/chroot2sb:53 bin/dir2sb:45 bin/savechanges:63 bin/sb:52
#: bin/sb2dir:44 bin/script2sb:41
msgid "Display this help and exit"
msgstr "Отобразить эту справку и выйти"

#: bin/apt2sb:47 bin/chroot2sb:54 bin/dir2sb:46 bin/savechanges:64 bin/sb:53
#: bin/sb2dir:45 bin/script2sb:42
msgid "Display version information and exit"
msgstr "Отобразить информацию о версии и выйти"

#: bin/apt2sb:49
msgid "Apt Options (for install/upgrade command)"
msgstr "Параметры Apt (для команды установки/обновления)"

#: bin/apt2sb:50
msgid "Automatic yes to prompts"
msgstr "Автоматический ответ «да» на запросы"

#: bin/apt2sb:51
msgid "Allow downgrades of packages"
msgstr "Разрешить понижение версий пакетов"

#: bin/apt2sb:52
msgid "Consider recommended packages as a dependency for installing"
msgstr "Рассматривать рекомендованные пакеты как зависимость при установке"

#: bin/apt2sb:53
msgid "Consider suggested packages as a dependency for installing"
msgstr "Рассматривать предлагаемые пакеты как зависимость при установке"

#: bin/apt2sb:54
msgid "Do not consider recommended packages as a dependency for installing"
msgstr "Не рассматривать рекомендованные пакеты как зависимость при установке"

#: bin/apt2sb:55
msgid "Do not consider suggested packages as a dependency for installing"
msgstr "Не рассматривать предлагаемые пакеты как зависимость при установке"

#: bin/apt2sb:56
msgid "Default release for package installation"
msgstr "Выпуск по умолчанию для установки пакетов"

#: bin/apt2sb:58 bin/chroot2sb:56 bin/sb:55 bin/script2sb:44
msgid "Examples"
msgstr "Примеры"

#: bin/apt2sb:69 bin/apt2sb:72 bin/chroot2sb:67 bin/chroot2sb:70 bin/dir2sb:53
#: bin/savechanges:71 bin/sb:69 bin/sb2dir:52 bin/script2sb:55 bin/script2sb:58
msgid "Try"
msgstr "Попробуйте"

#: bin/apt2sb:69 bin/apt2sb:72 bin/chroot2sb:67 bin/chroot2sb:70 bin/dir2sb:53
#: bin/savechanges:71 bin/sb:69 bin/sb2dir:52 bin/script2sb:55 bin/script2sb:58
msgid "for more information."
msgstr "для получения дополнительной информации."

#: bin/chroot2sb:39
msgid "Packages a module from changes made in an interactive chroot"
msgstr "Упаковывает модуль из изменений, внесённых в интерактивном chroot"

#: bin/chroot2sb:41
msgid "Lifecycle commands"
msgstr "Команды жизненного цикла"

#: bin/chroot2sb:42
msgid "Prepare a protected interactive build session"
msgstr "Подготовить защищённую интерактивную сессию сборки"

#: bin/chroot2sb:43
msgid "Attach an interactive chroot shell to the current terminal"
msgstr "Подключить интерактивную оболочку chroot к текущему терминалу"

#: bin/chroot2sb:44
msgid "Capture and close a prepared session"
msgstr "Сохранить в модуль и закрыть подготовленную сессию"

#: bin/chroot2sb:45
msgid "Discard and close a prepared session"
msgstr "Отменить и закрыть подготовленную сессию"

#: bin/chroot2sb:48 bin/script2sb:36
msgid "Copy contents of DIR to the root of the module"
msgstr "Скопировать содержимое КАТАЛОГА в корень модуля"

#: bin/chroot2sb:49 bin/script2sb:37
msgid "Use NAME as the filename for the module"
msgstr "Использовать ИМЯ как имя файла для модуля"

#: bin/dir2sb:37
msgid "Convert a directory tree into a compressed .sb module."
msgstr "Преобразовать дерево каталогов в сжатый .sb-модуль."

#: bin/dir2sb:39 bin/savechanges:51
msgid "Compression: zstd, gzip, lzo, lz4, or xz (default: zstd)"
msgstr "Сжатие: zstd, gzip, lzo, lz4 или xz (по умолчанию: zstd)"

#: bin/dir2sb:40 bin/savechanges:52 bin/sb2dir:39
msgid "Bundle extension used in help text (default: sb)"
msgstr "Расширение пакета, используемое в справке (по умолчанию: sb)"

#: bin/dir2sb:41
msgid "Preserve source ownership instead of normalizing to root (needs privilege)"
msgstr "Сохранять владельцев исходных файлов вместо нормализации к root (требуются права администратора)"

#: bin/dir2sb:42 bin/sb2dir:41
msgid "Permit device nodes, sockets, and FIFOs (needs privilege)"
msgstr "Разрешить специальные файлы: device nodes, сокеты и FIFO (требуются права администратора)"

#: bin/dir2sb:43 bin/sb2dir:42
msgid "Emit phase events and a machine-readable result"
msgstr "Выводить события этапов и машиночитаемый результат"

#: bin/dir2sb:44 bin/savechanges:62 bin/sb2dir:43
msgid "Disable colored output"
msgstr "Отключить цветной вывод"

#: bin/dir2sb:47
msgid "The contents of SOURCE_DIRECTORY become the module root. Neither the source"
msgstr "Содержимое SOURCE_DIRECTORY становится корнем модуля. Ни исходный"

#: bin/dir2sb:48
msgid "nor an existing TARGET is modified; the module is published atomically."
msgstr "файлы, ни существующий TARGET не изменяются; модуль публикуется атомарно."

