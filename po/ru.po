msgid "Option requires an argument:"
msgstr "Для этой опции требуется аргумент:"

#: bin/dir2sb:90 bin/savechanges:113 bin/sb2dir:89
msgid "must not contain newline characters"
msgstr "не должно содержать символы новой строки"

