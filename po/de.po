#: debian/minios-tools/etc/xdg/autostart/minios-setup-keyboard.desktop:7
msgid "MiniOS Keyboard Setup"
msgstr "MiniOS Tastatureinrichtung"

#: autostart/minios-setup-keyboard.desktop:17
#: debian/minios-tools/etc/xdg/autostart/minios-setup-keyboard.desktop:17
msgid "Configure keyboard layout from boot parameters"
msgstr "Konfiguriert Tastaturlayout aus Boot-Parametern"

#: autostart/minios-virtual-resolution.desktop:7
#: debian/minios-tools/etc/xdg/autostart/minios-virtual-resolution.desktop:7
msgid "MiniOS Virtual Resolution Change"
msgstr "MiniOS Virtuelle Auflösungsänderung"

#: autostart/minios-virtual-resolution.desktop:17
