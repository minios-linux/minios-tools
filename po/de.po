#: bin/apt2sb:20 bin/apt2sb:53 bin/chroot2sb:19 bin/chroot2sb:39 bin/dir2sb:11
#: bin/dir2sb:31 bin/rmsbdir:9 bin/savechanges:22 bin/savechanges:38 bin/sb:30
#: bin/sb:59 bin/sb2iso:26 bin/sb2iso:55 bin/script2sb:20 bin/script2sb:42
msgid "Usage"
msgstr "Verwendung"

#: bin/apt2sb:21
msgid "Installs packages from repositories and packages them into a module."
msgstr "Installiert Pakete aus Repositories und packt sie in ein Modul."

#: bin/apt2sb:23 bin/sb:34
msgid "Commands"
msgstr "Befehle"

#: bin/apt2sb:24
msgid "Install package(s)"
msgstr "Paket(e) installieren"

#: bin/apt2sb:25
msgid "Upgrade installed packages"
msgstr "Installierte Pakete aktualisieren"

#: bin/apt2sb:27 bin/chroot2sb:22 bin/dir2sb:14 bin/savechanges:25
#: bin/sb2iso:29 bin/script2sb:23
msgid "Options"
msgstr "Optionen"

#: bin/apt2sb:28
msgid "Use NAME as the filename for the module instead of PACKAGE1"
msgstr "NAME als Dateinamen für das Modul statt PAKET1 verwenden"

#: bin/apt2sb:29 bin/chroot2sb:25 bin/script2sb:28
msgid "Use LEVEL as the filter level"
msgstr "LEVEL als Filterstufe verwenden"

#: bin/apt2sb:30 bin/chroot2sb:26 bin/dir2sb:16 bin/savechanges:26
#: bin/script2sb:25
msgid "Compression type (zstd, gzip, lzo, xz). Default: zstd"
msgstr "Komprimierungstyp (zstd, gzip, lzo, xz). Standard: zstd"

#: bin/apt2sb:31 bin/chroot2sb:27 bin/dir2sb:15 bin/savechanges:27
#: bin/script2sb:24
msgid "Bundle extension. Default: sb"
msgstr "Bundle-Erweiterung. Standard: sb"

#: bin/apt2sb:32 bin/chroot2sb:28 bin/dir2sb:17 bin/savechanges:28 bin/sb:44
#: bin/sb2iso:35 bin/script2sb:30
msgid "Display this help and exit"
msgstr "Diese Hilfe anzeigen und beenden"

#: bin/apt2sb:33 bin/chroot2sb:29 bin/dir2sb:18 bin/savechanges:29 bin/sb:45
#: bin/sb2iso:36 bin/script2sb:31
msgid "Display version information and exit"
msgstr "Versionsinformationen anzeigen und beenden"

#: bin/apt2sb:35
msgid "Apt Options (for install/upgrade command)"
msgstr "Apt-Optionen (für Installieren-/Aktualisieren-Befehl)"

#: bin/apt2sb:36
msgid "Automatic yes to prompts"
msgstr "Automatische Ja-Antwort auf Abfragen"

#: bin/apt2sb:37
msgid "Allow downgrades of packages"
msgstr "Downgrades von Paketen erlauben"

#: bin/apt2sb:38
msgid "Consider recommended packages as a dependency for installing"
msgstr "Empfohlene Pakete als Installationsabhängigkeit betrachten"

#: bin/apt2sb:39
msgid "Consider suggested packages as a dependency for installing"
msgstr "Vorgeschlagene Pakete als Installationsabhängigkeit betrachten"

#: bin/apt2sb:40
msgid "Do not consider recommended packages as a dependency for installing"
msgstr "Empfohlene Pakete nicht als Installationsabhängigkeit betrachten"

#: bin/apt2sb:41
msgid "Do not consider suggested packages as a dependency for installing"
msgstr "Vorgeschlagene Pakete nicht als Installationsabhängigkeit betrachten"

#: bin/apt2sb:42
msgid "Default release to install packages from"
msgstr "Standard-Release, von dem Pakete installiert werden sollen"

#: bin/apt2sb:44 bin/chroot2sb:31 bin/sb:47 bin/sb2iso:38 bin/script2sb:33
msgid "Examples"
msgstr "Beispiele"

#: bin/apt2sb:54 bin/chroot2sb:40 bin/dir2sb:32 bin/savechanges:39 bin/sb:61
#: bin/sb2iso:56 bin/script2sb:43
msgid "Try"
msgstr "Versuchen Sie"

#: bin/apt2sb:54 bin/chroot2sb:40 bin/dir2sb:32 bin/savechanges:39 bin/sb:61
#: bin/sb2iso:56 bin/script2sb:43
msgid "for more information."
msgstr "für weitere Informationen."

#: bin/chroot2sb:20 bin/script2sb:21
msgid "Packages a module from changes made by an installation script"
msgstr "Packt ein Modul aus Änderungen, die von einem Installationsskript vorgenommen wurden"

#: bin/chroot2sb:23 bin/script2sb:26
msgid "Copy contents of DIR to the root of the module"
msgstr "Inhalt von VERZEICHNIS in das Wurzelverzeichnis des Moduls kopieren"

#: bin/chroot2sb:24 bin/script2sb:27
msgid "Use NAME as the filename for the module"
msgstr "NAME als Dateiname für das Modul verwenden"

#: bin/dir2sb:12
msgid "Converts a directory to a compressed .sb module"
msgstr "Konvertiert ein Verzeichnis in ein komprimiertes .sb-Modul"

#: bin/dir2sb:20
msgid "Arguments"
msgstr "Argumente"

#: bin/dir2sb:21
msgid "The directory to convert to a module"
msgstr "Das Verzeichnis, das in ein Modul konvertiert werden soll"

#: bin/dir2sb:22
msgid "Optional. The name of the output module file"
msgstr "Optional. Der Name der Ausgabemoduldatei"

#: bin/dir2sb:24
msgid "Behavior"
msgstr "Verhalten"

#: bin/dir2sb:25
msgid "If SOURCE_DIRECTORY does not have a .sb extension and is not 'squashfs-root', then the directory itself is included in the module, and TARGET_FILE is required."
msgstr "Falls SOURCE_DIRECTORY keine .sb-Erweiterung hat und nicht 'squashfs-root' ist, wird das Verzeichnis selbst in das Modul aufgenommen, und ZIELDATEI ist erforderlich."

#: bin/dir2sb:26
msgid "If TARGET_FILE is not specified, SOURCE_DIRECTORY is replaced by the new module file."
msgstr "Falls ZIELDATEI nicht angegeben ist, wird QUELLVERZEICHNIS durch die neue Moduldatei ersetzt."

#: bin/rmsbdir:8
msgid "Erase module directory created by sb2dir"
msgstr "Modulverzeichnis, das von sb2dir erstellt wurde, löschen"

#: bin/rmsbdir:9
msgid "source_directory.sb"
msgstr "quellverzeichnis.sb"

#: bin/rmsbdir:18 bin/sb2dir:35
msgid "Directory does not exist:"
msgstr "Verzeichnis existiert nicht:"

#: bin/rmsbdir:25
msgid "Module directory deleted:"
msgstr "Modulverzeichnis gelöscht:"

#: bin/savechanges:23
msgid "Saves all changed files in a compressed filesystem bundle."
msgstr "Speichert alle geänderten Dateien in einem komprimierten Dateisystem-Bundle."

#: bin/savechanges:31
msgid "If changes_directory is not specified, the default changes"
msgstr "Wenn 'Änderungsverzeichnis' nicht angegeben ist, wird das Standard-Änderungsverzeichnis"

#: bin/savechanges:32
msgid "directory from the current initramfs is used."
msgstr "aus dem aktuellen Initramfs verwendet."

#: bin/sb:31
msgid "Manage MiniOS bundles."
msgstr "MiniOS-Bundles verwalten."

#: bin/sb:32 bin/sb:60
msgid "To run some of the commands in this script, your Linux kernel must support AUFS."
msgstr "Um einige der Befehle in diesem Skript auszuführen, muss Ihr Linux-Kernel AUFS unterstützen."

#: bin/sb:35
msgid "Activate a MiniOS bundle"
msgstr "Ein MiniOS-Bundle aktivieren"

#: bin/sb:36
msgid "Deactivate an active MiniOS bundle"
msgstr "Ein aktives MiniOS-Bundle deaktivieren"

#: bin/sb:37
msgid "List active MiniOS bundles"
msgstr "Aktive MiniOS-Bundles auflisten"

#: bin/sb:38
msgid "Save changes made at runtime to the bundle"
msgstr "Zur Laufzeit vorgenommene Änderungen im Bundle speichern"

#: bin/sb:40 bin/sb:41
msgid "Remove an unpacked bundle directory"
msgstr "Ein entpacktes Bundle-Verzeichnis entfernen"

#: bin/sb:42
msgid "Convert an .sb bundle to directory or vice versa"
msgstr "Ein .sb-Bundle in ein Verzeichnis umwandeln oder umgekehrt"

#: bin/sb2dir:9
msgid "Usage:"
msgstr "Verwendung:"

#: bin/sb2dir:10
msgid "If the output_directory is specified, it must exist"
msgstr "Wenn das Ausgabeverzeichnis angegeben ist, muss es existieren"

#: bin/sb2dir:11
msgid "If the output_directory is not specified, the name source_file.sb"
msgstr "Wenn das Ausgabeverzeichnis nicht angegeben ist, wird der Name quell_datei.sb"

#: bin/sb2dir:12
msgid "is used and the directory is overmounted with tmpfs"
msgstr "verwendet und das Verzeichnis mit tmpfs überlagert."

#: bin/sb2dir:17
msgid "File does not exist:"
msgstr "Datei existiert nicht:"

#: bin/sb2iso:27
msgid "Generate MiniOS ISO image, adding specified modules."
msgstr "MiniOS ISO-Abbild generieren und dabei angegebene Module hinzufügen."

#: bin/sb2iso:30
msgid "Exclude any existing path or file matching REGEX"
msgstr "Vorhandene Pfade oder Dateien, die REGEX entsprechen, ausschließen"

#: bin/sb2iso:31
msgid "Specify output ISO filename (default"
msgstr "Ausgabe-ISO-Dateiname angeben (Standard"

#: bin/sb2iso:32
msgid "Set menu type: multilang or language code"
msgstr "Menütyp festlegen: Mehrsprachig oder Sprachcode"

#: bin/sb2iso:33
msgid "  multilang: menu with language selection (default)"
msgstr "  mehrsprachig: Menü mit Sprachauswahl (Standard)"

#: bin/sb2iso:34
msgid "  language: specific language (en_US, ru_RU, de_DE, etc.)"
msgstr "  Sprache: bestimmte Sprache (en_US, ru_RU, de_DE, usw.)"

#: bin/sb2iso:39
msgid "Create basic MiniOS ISO with current system:"
msgstr "Basis-MiniOS-ISO mit aktuellem System erstellen:"

#: bin/sb2iso:41
msgid "Create ISO with custom filename:"
msgstr "ISO mit benutzerdefiniertem Dateinamen erstellen:"

#: bin/sb2iso:43
msgid "Create ISO excluding specific modules:"
msgstr "ISO erstellen und bestimmte Module ausschließen:"

#: bin/sb2iso:45
msgid "Create minimal text-mode ISO:"
msgstr "Minimale ISO im Textmodus erstellen:"

#: bin/sb2iso:47
msgid "Create ISO with additional modules:"
msgstr "ISO mit zusätzlichen Modulen erstellen:"

#: bin/sb2iso:49
msgid "Create Russian localized ISO:"
msgstr "Russisch lokalisierte ISO erstellen:"

#: bin/sb2iso:231
msgid "grub.template.cfg template not found"
msgstr "grub.template.cfg-Vorlage nicht gefunden"

#: bin/sb2iso:482
msgid "Cannot find MiniOS source directory with boot files"
msgstr "MiniOS-Quellverzeichnis mit Boot-Dateien kann nicht gefunden werden"

#: bin/sb2iso:488
msgid "Detected bootloader type"
msgstr "Erkannter Bootloader-Typ"

#: bin/sb2iso:525
msgid "Unknown bootloader type"
msgstr "Unbekannter Bootloader-Typ"

#: bin/sb2iso:526
msgid "Valid types: grub-only, syslinux-native, syslinux-grub"
msgstr "Gültige Typen: grub-only, syslinux-native, syslinux-grub"

#: bin/sb2iso:534
msgid "If you loaded the system into RAM, use 'toram=full' in the kernel parameters."
msgstr "Wenn Sie das System in den RAM geladen haben, verwenden Sie 'toram=full' in den Kernel-Parametern."

#: bin/sb2iso:557
msgid "Using multilingual menu"
msgstr "Mehrsprachiges Menü wird verwendet"

#: bin/sb2iso:565
msgid "Using multilingual SYSLINUX configuration"
msgstr "Mehrsprachige SYSLINUX-Konfiguration wird verwendet"

#: bin/sb2iso:572
msgid "Configuring localized menu for"
msgstr "Lokales Menü wird konfiguriert für"

#: bin/sb2iso:577
msgid "Generated localized GRUB menu for"
msgstr "Lokales GRUB-Menü generiert für"

#: bin/sb2iso:581
msgid "Failed to generate localized GRUB config, falling back to English"
msgstr "Lokalisierte GRUB-Konfiguration konnte nicht erstellt werden, es wird auf Englisch zurückgegriffen"

#: bin/sb2iso:594
msgid "Using localized SYSLINUX configuration for"
msgstr "Lokalisierte SYSLINUX-Konfiguration wird verwendet für"

#: bin/sb2iso:598
msgid "Localized configuration not found for"
msgstr "Lokalisierte Konfiguration nicht gefunden für"

#: bin/sb2iso:598
msgid "using English"
msgstr "Englisch wird verwendet"

#: bin/sb2iso:620
msgid "Creating ISO work directory"
msgstr "ISO-Arbeitsverzeichnis wird erstellt"

#: bin/sb2iso:624
msgid "Copying boot files (GRUB BIOS only)"
msgstr "Boot-Dateien werden kopiert (nur GRUB BIOS)"

#: bin/sb2iso:627
msgid "Copying boot files (SYSLINUX native)"
msgstr "Boot-Dateien werden kopiert (SYSLINUX nativ)"

#: bin/sb2iso:630
msgid "Copying boot files (SYSLINUX + GRUB)"
msgstr "Boot-Dateien werden kopiert (SYSLINUX + GRUB)"

#: bin/sb2iso:634
msgid "Internal error: invalid bootloader type for boot files"
msgstr "Interner Fehler: Ungültiger Bootloader-Typ für Boot-Dateien"

#: bin/sb2iso:653
msgid "Created Ventoy compatibility symlinks in ISO:"
msgstr "Ventoy-Kompatibilitätssymlinks wurden erstellt:"

#: bin/sb2iso:662
msgid "Creating temporary persistence image"
msgstr "Temporäres Persistenz-Abbild wird erstellt"

#: bin/sb2iso:663
msgid "Formatting persistence image"
msgstr "Persistenz-Abbild wird formatiert"

#: bin/sb2iso:682
msgid "Internal error: invalid bootloader type for ISO parameters"
msgstr "Interner Fehler: Ungültiger Bootloader-Typ für ISO-Parameter"

#: bin/sb2iso:687
msgid "Generating ISO image"
msgstr "ISO-Abbild wird generiert"

#: bin/sb2iso:715
msgid "Failed to create ISO image"
msgstr "Fehler beim Erstellen des ISO-Abbilds"

#: bin/script2sb:29
msgid "Use FILE as the installation script"
msgstr "DATEI als Installationsskript verwenden"

