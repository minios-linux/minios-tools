#: bin/apt2sb:20 bin/apt2sb:53 bin/chroot2sb:19 bin/chroot2sb:39 bin/dir2sb:11
#: bin/dir2sb:31 bin/rmsbdir:9 bin/savechanges:22 bin/savechanges:38 bin/sb:30
#: bin/sb:59 bin/sb2iso:26 bin/sb2iso:55 bin/script2sb:20 bin/script2sb:42
msgid "Usage"
msgstr "Utilisation"

#: bin/apt2sb:21
msgid "Installs packages from repositories and packages them into a module."
msgstr "Installe des paquets depuis des dépôts et les emballe dans un module."

#: bin/apt2sb:23 bin/sb:34
msgid "Commands"
msgstr "Commandes"

#: bin/apt2sb:24
msgid "Install package(s)"
msgstr "Installer le(s) paquet(s)"

#: bin/apt2sb:25
msgid "Upgrade installed packages"
msgstr "Mettre à niveau les paquets installés"

#: bin/apt2sb:27 bin/chroot2sb:22 bin/dir2sb:14 bin/savechanges:25
#: bin/sb2iso:29 bin/script2sb:23
msgid "Options"
msgstr "Options"

#: bin/apt2sb:28
msgid "Use NAME as the filename for the module instead of PACKAGE1"
msgstr "Utiliser NOM comme nom de fichier pour le module au lieu de PAQUET1"

#: bin/apt2sb:29 bin/chroot2sb:25 bin/script2sb:28
msgid "Use LEVEL as the filter level"
msgstr "Utiliser NIVEAU comme niveau de filtre"

#: bin/apt2sb:30 bin/chroot2sb:26 bin/dir2sb:16 bin/savechanges:26
#: bin/script2sb:25
msgid "Compression type (zstd, gzip, lzo, xz). Default: zstd"
msgstr "Type de compression (zstd, gzip, lzo, xz). Par défaut : zstd"

#: bin/apt2sb:31 bin/chroot2sb:27 bin/dir2sb:15 bin/savechanges:27
#: bin/script2sb:24
msgid "Bundle extension. Default: sb"
msgstr "Extension du paquet. Par défaut : sb"

#: bin/apt2sb:32 bin/chroot2sb:28 bin/dir2sb:17 bin/savechanges:28 bin/sb:44
#: bin/sb2iso:35 bin/script2sb:30
msgid "Display this help and exit"
msgstr "Afficher cette aide et quitter"

#: bin/apt2sb:33 bin/chroot2sb:29 bin/dir2sb:18 bin/savechanges:29 bin/sb:45
#: bin/sb2iso:36 bin/script2sb:31
msgid "Display version information and exit"
msgstr "Afficher les informations de version et quitter"

#: bin/apt2sb:35
msgid "Apt Options (for install/upgrade command)"
msgstr "Options d'Apt (pour les commandes installer/mettre à niveau)"

#: bin/apt2sb:36
msgid "Automatic yes to prompts"
msgstr "Répondre oui automatiquement aux invites"

#: bin/apt2sb:37
msgid "Allow downgrades of packages"
msgstr "Autoriser les rétrogradations de paquets"

#: bin/apt2sb:38
msgid "Consider recommended packages as a dependency for installing"
msgstr "Considérer les paquets recommandés comme une dépendance à l'installation"

#: bin/apt2sb:39
msgid "Consider suggested packages as a dependency for installing"
msgstr "Considérer les paquets suggérés comme une dépendance à l'installation"

#: bin/apt2sb:40
msgid "Do not consider recommended packages as a dependency for installing"
msgstr "Ne pas considérer les paquets recommandés comme une dépendance à l'installation"

#: bin/apt2sb:41
msgid "Do not consider suggested packages as a dependency for installing"
msgstr "Ne pas considérer les paquets suggérés comme une dépendance à l'installation"

#: bin/apt2sb:42
msgid "Default release to install packages from"
msgstr "Version par défaut pour l'installation des paquets"

#: bin/apt2sb:44 bin/chroot2sb:31 bin/sb:47 bin/sb2iso:38 bin/script2sb:33
msgid "Examples"
msgstr "Exemples"

#: bin/apt2sb:54 bin/chroot2sb:40 bin/dir2sb:32 bin/savechanges:39 bin/sb:61
#: bin/sb2iso:56 bin/script2sb:43
msgid "Try"
msgstr "Essayez"

#: bin/apt2sb:54 bin/chroot2sb:40 bin/dir2sb:32 bin/savechanges:39 bin/sb:61
#: bin/sb2iso:56 bin/script2sb:43
msgid "for more information."
msgstr "pour plus d'informations."

#: bin/chroot2sb:20 bin/script2sb:21
msgid "Packages a module from changes made by an installation script"
msgstr "Emballe un module à partir des modifications effectuées par un script d'installation"

#: bin/chroot2sb:23 bin/script2sb:26
msgid "Copy contents of DIR to the root of the module"
msgstr "Copier le contenu de DIR dans la racine du module"

#: bin/chroot2sb:24 bin/script2sb:27
msgid "Use NAME as the filename for the module"
msgstr "Utiliser NOM comme nom de fichier pour le module"

#: bin/dir2sb:12
msgid "Converts a directory to a compressed .sb module"
msgstr "Convertit un répertoire en un module .sb compressé"

#: bin/dir2sb:20
msgid "Arguments"
msgstr "Arguments"

#: bin/dir2sb:21
msgid "The directory to convert to a module"
msgstr "Le répertoire à convertir en module"

#: bin/dir2sb:22
msgid "Optional. The name of the output module file"
msgstr "Optionnel. Le nom du fichier module de sortie"

#: bin/dir2sb:24
msgid "Behavior"
msgstr "Comportement"

#: bin/dir2sb:25
msgid "If SOURCE_DIRECTORY does not have a .sb extension and is not 'squashfs-root', then the directory itself is included in the module, and TARGET_FILE is required."
msgstr "Si REPERTOIRE_SOURCE n'a pas d'extension .sb et n'est pas 'squashfs-root', alors le répertoire lui-même est inclus dans le module, et FICHIER_CIBLE est requis."

#: bin/dir2sb:26
msgid "If TARGET_FILE is not specified, SOURCE_DIRECTORY is replaced by the new module file."
msgstr "Si FICHIER_CIBLE n'est pas spécifié, REPERTOIRE_SOURCE est remplacé par le nouveau fichier module."

#: bin/rmsbdir:8
msgid "Erase module directory created by sb2dir"
msgstr "Effacer le répertoire du module créé par sb2dir"

#: bin/rmsbdir:9
msgid "source_directory.sb"
msgstr "repertoire_source.sb"

#: bin/rmsbdir:18 bin/sb2dir:35
msgid "Directory does not exist:"
msgstr "Le répertoire n'existe pas :"

#: bin/rmsbdir:25
msgid "Module directory deleted:"
msgstr "Répertoire du module supprimé :"

#: bin/savechanges:23
msgid "Saves all changed files in a compressed filesystem bundle."
msgstr "Sauvegarde tous les fichiers modifiés dans un paquet de système de fichiers compressé."

#: bin/savechanges:31
msgid "If changes_directory is not specified, the default changes"
msgstr "Si changes_directory n'est pas spécifié, les modifications par défaut"

#: bin/savechanges:32
msgid "directory from the current initramfs is used."
msgstr "le répertoire de l'initramfs actuel est utilisé."

#: bin/sb:31
msgid "Manage MiniOS bundles."
msgstr "Gérer les paquets MiniOS."

#: bin/sb:32 bin/sb:60
msgid "To run some of the commands in this script, your Linux kernel must support AUFS."
msgstr "Pour exécuter certaines des commandes de ce script, votre noyau Linux doit prendre en charge AUFS."

#: bin/sb:35
msgid "Activate a MiniOS bundle"
msgstr "Activer un paquet MiniOS"

#: bin/sb:36
msgid "Deactivate an active MiniOS bundle"
msgstr "Désactiver un paquet MiniOS actif"

#: bin/sb:37
msgid "List active MiniOS bundles"
msgstr "Lister les paquets MiniOS actifs"

#: bin/sb:38
msgid "Save changes made at runtime to the bundle"
msgstr "Sauvegarder les changements faits en temps réel dans le paquet"

#: bin/sb:40 bin/sb:41
msgid "Remove an unpacked bundle directory"
msgstr "Supprimer un répertoire de paquet décompressé"

#: bin/sb:42
msgid "Convert an .sb bundle to directory or vice versa"
msgstr "Convertir un paquet .sb en répertoire ou vice versa"

#: bin/sb2dir:9
msgid "Usage:"
msgstr "Utilisation :"

#: bin/sb2dir:10
msgid "If the output_directory is specified, it must exist"
msgstr "Si le répertoire_de_sortie est spécifié, il doit exister"

#: bin/sb2dir:11
msgid "If the output_directory is not specified, the name source_file.sb"
msgstr "Si le répertoire_de_sortie n'est pas spécifié, le nom fichier_source.sb"

#: bin/sb2dir:12
msgid "is used and the directory is overmounted with tmpfs"
msgstr "est utilisé et le répertoire est surmonté avec tmpfs"

#: bin/sb2dir:17
msgid "File does not exist:"
msgstr "Le fichier n'existe pas :"

#: bin/sb2iso:27
msgid "Generate MiniOS ISO image, adding specified modules."
msgstr "Générer une image ISO MiniOS en ajoutant les modules spécifiés."

#: bin/sb2iso:30
msgid "Exclude any existing path or file matching REGEX"
msgstr "Exclure tout chemin ou fichier existant correspondant à REGEX"

#: bin/sb2iso:31
msgid "Specify output ISO filename (default"
msgstr "Spécifier le nom du fichier ISO de sortie (par défaut"

#: bin/sb2iso:32
msgid "Set menu type: multilang or language code"
msgstr "Définir le type de menu : multilangue ou code de langue"

#: bin/sb2iso:33
msgid "  multilang: menu with language selection (default)"
msgstr "  multilangue : menu avec sélection de la langue (par défaut)"

#: bin/sb2iso:34
msgid "  language: specific language (en_US, ru_RU, de_DE, etc.)"
msgstr "  langue : langue spécifique (en_US, ru_RU, de_DE, etc.)"

