#: bin/apt2sb:20 bin/apt2sb:53 bin/chroot2sb:19 bin/chroot2sb:39 bin/dir2sb:11
#: bin/dir2sb:31 bin/rmsbdir:9 bin/savechanges:22 bin/savechanges:38 bin/sb:30
#: bin/sb:59 bin/sb2iso:26 bin/sb2iso:55 bin/script2sb:20 bin/script2sb:42
msgid "Usage"
msgstr "Uso"

#: bin/apt2sb:21
msgid "Installs packages from repositories and packages them into a module."
msgstr "Instala paquetes desde repositorios y los empaqueta en un módulo."

#: bin/apt2sb:23 bin/sb:34
msgid "Commands"
msgstr "Comandos"

#: bin/apt2sb:24
msgid "Install package(s)"
msgstr "Instalar paquete(s)"

#: bin/apt2sb:25
msgid "Upgrade installed packages"
msgstr "Actualizar paquetes instalados"

#: bin/apt2sb:27 bin/chroot2sb:22 bin/dir2sb:14 bin/savechanges:25
#: bin/sb2iso:29 bin/script2sb:23
msgid "Options"
msgstr "Opciones"

#: bin/apt2sb:28
msgid "Use NAME as the filename for the module instead of PACKAGE1"
msgstr "Usar NOMBRE como nombre de archivo para el módulo en lugar de PAQUETE1"

#: bin/apt2sb:29 bin/chroot2sb:25 bin/script2sb:28
msgid "Use LEVEL as the filter level"
msgstr "Usar NIVEL como nivel de filtro"

#: bin/apt2sb:30 bin/chroot2sb:26 bin/dir2sb:16 bin/savechanges:26
#: bin/script2sb:25
msgid "Compression type (zstd, gzip, lzo, xz). Default: zstd"
msgstr "Tipo de compresión (zstd, gzip, lzo, xz). Predeterminado: zstd"

#: bin/apt2sb:31 bin/chroot2sb:27 bin/dir2sb:15 bin/savechanges:27
#: bin/script2sb:24
msgid "Bundle extension. Default: sb"
msgstr "Extensión del paquete. Predeterminado: sb"

#: bin/apt2sb:32 bin/chroot2sb:28 bin/dir2sb:17 bin/savechanges:28 bin/sb:44
#: bin/sb2iso:35 bin/script2sb:30
msgid "Display this help and exit"
msgstr "Mostrar esta ayuda y salir"

#: bin/apt2sb:33 bin/chroot2sb:29 bin/dir2sb:18 bin/savechanges:29 bin/sb:45
#: bin/sb2iso:36 bin/script2sb:31
msgid "Display version information and exit"
msgstr "Mostrar información de versión y salir"

#: bin/apt2sb:35
msgid "Apt Options (for install/upgrade command)"
msgstr "Opciones de Apt (para el comando instalar/actualizar)"

#: bin/apt2sb:36
msgid "Automatic yes to prompts"
msgstr "Sí automático a las preguntas"

#: bin/apt2sb:37
msgid "Allow downgrades of packages"
msgstr "Permitir degradaciones de paquetes"

#: bin/apt2sb:38
msgid "Consider recommended packages as a dependency for installing"
msgstr "Considerar paquetes recomendados como dependencia para la instalación"

#: bin/apt2sb:39
msgid "Consider suggested packages as a dependency for installing"
msgstr "Considerar paquetes sugeridos como dependencia para la instalación"

#: bin/apt2sb:40
msgid "Do not consider recommended packages as a dependency for installing"
msgstr "No considerar paquetes recomendados como dependencia para la instalación"

#: bin/apt2sb:41
msgid "Do not consider suggested packages as a dependency for installing"
msgstr "No considerar paquetes sugeridos como dependencia para la instalación"

#: bin/apt2sb:42
msgid "Default release to install packages from"
msgstr "Versión predeterminada para instalar paquetes"

#: bin/apt2sb:44 bin/chroot2sb:31 bin/sb:47 bin/sb2iso:38 bin/script2sb:33
msgid "Examples"
msgstr "Ejemplos"

#: bin/apt2sb:54 bin/chroot2sb:40 bin/dir2sb:32 bin/savechanges:39 bin/sb:61
#: bin/sb2iso:56 bin/script2sb:43
msgid "Try"
msgstr "Pruebe"

#: bin/apt2sb:54 bin/chroot2sb:40 bin/dir2sb:32 bin/savechanges:39 bin/sb:61
#: bin/sb2iso:56 bin/script2sb:43
msgid "for more information."
msgstr "para más información."

#: bin/chroot2sb:20 bin/script2sb:21
msgid "Packages a module from changes made by an installation script"
msgstr "Empaqueta un módulo a partir de los cambios realizados por un script de instalación"

#: bin/chroot2sb:23 bin/script2sb:26
msgid "Copy contents of DIR to the root of the module"
msgstr "Copiar contenido de DIR a la raíz del módulo"

#: bin/chroot2sb:24 bin/script2sb:27
msgid "Use NAME as the filename for the module"
msgstr "Usar NOMBRE como nombre de archivo para el módulo"

#: bin/dir2sb:12
msgid "Converts a directory to a compressed .sb module"
msgstr "Convierte un directorio en un módulo .sb comprimido"

#: bin/dir2sb:20
msgid "Arguments"
msgstr "Argumentos"

#: bin/dir2sb:21
msgid "The directory to convert to a module"
msgstr "El directorio a convertir en un módulo"

#: bin/dir2sb:22
msgid "Optional. The name of the output module file"
msgstr "Opcional. El nombre del archivo del módulo de salida"

#: bin/dir2sb:24
msgid "Behavior"
msgstr "Comportamiento"

#: bin/dir2sb:25
msgid "If SOURCE_DIRECTORY does not have a .sb extension and is not 'squashfs-root', then the directory itself is included in the module, and TARGET_FILE is required."
msgstr "Si DIRECTORIO_ORIGEN no tiene una extensión .sb y no es 'squashfs-root', entonces el propio directorio se incluye en el módulo, y ARCHIVO_DESTINO es requerido."

#: bin/dir2sb:26
msgid "If TARGET_FILE is not specified, SOURCE_DIRECTORY is replaced by the new module file."
msgstr "Si no se especifica ARCHIVO_DESTINO, DIRECTORIO_ORIGEN es reemplazado por el nuevo archivo del módulo."

#: bin/rmsbdir:8
msgid "Erase module directory created by sb2dir"
msgstr "Borrar directorio de módulo creado por sb2dir"

#: bin/rmsbdir:9
msgid "source_directory.sb"
msgstr "directorio_origen.sb"

#: bin/rmsbdir:18 bin/sb2dir:35
msgid "Directory does not exist:"
msgstr "El directorio no existe:"

#: bin/rmsbdir:25
msgid "Module directory deleted:"
msgstr "Directorio del módulo eliminado:"

#: bin/savechanges:23
msgid "Saves all changed files in a compressed filesystem bundle."
msgstr "Guarda todos los archivos cambiados en un paquete de sistema de archivos comprimido."

#: bin/savechanges:31
msgid "If changes_directory is not specified, the default changes"
msgstr "Si no se especifica el directorio_de_cambios,"

#: bin/savechanges:32
msgid "directory from the current initramfs is used."
msgstr "se utiliza el directorio de cambios del initramfs actual."

#: bin/sb:31
msgid "Manage MiniOS bundles."
msgstr "Gestionar paquetes de MiniOS."

#: bin/sb:32 bin/sb:60
msgid "To run some of the commands in this script, your Linux kernel must support AUFS."
msgstr "Para ejecutar algunos de los comandos de este script, su kernel de Linux debe ser compatible con AUFS."

#: bin/sb:35
msgid "Activate a MiniOS bundle"
msgstr "Activar un paquete de MiniOS"

#: bin/sb:36
msgid "Deactivate an active MiniOS bundle"
msgstr "Desactivar un paquete de MiniOS activo"

#: bin/sb:37
msgid "List active MiniOS bundles"
msgstr "Listar paquetes de MiniOS activos"

#: bin/sb:38
msgid "Save changes made at runtime to the bundle"
msgstr "Guardar los cambios realizados en tiempo de ejecución en el paquete"

#: bin/sb:40 bin/sb:41
msgid "Remove an unpacked bundle directory"
msgstr "Eliminar un directorio de paquete desempaquetado"

#: bin/sb:42
msgid "Convert an .sb bundle to directory or vice versa"
msgstr "Convertir un paquete .sb a directorio o viceversa"

#: bin/sb2dir:9
msgid "Usage:"
msgstr "Uso:"

#: bin/sb2dir:10
msgid "If the output_directory is specified, it must exist"
msgstr "Si se especifica el directorio_de_salida, debe existir"

#: bin/sb2dir:11
msgid "If the output_directory is not specified, the name source_file.sb"
msgstr "Si no se especifica el directorio_de_salida, se utiliza el nombre archivo_origen.sb"

#: bin/sb2dir:12
msgid "is used and the directory is overmounted with tmpfs"
msgstr "y el directorio se sobremonta con tmpfs."

#: bin/sb2dir:17
msgid "File does not exist:"
msgstr "El archivo no existe:"

#: bin/sb2iso:27
msgid "Generate MiniOS ISO image, adding specified modules."
msgstr "Generar imagen ISO de MiniOS, añadiendo módulos especificados."

#: bin/sb2iso:30
msgid "Exclude any existing path or file matching REGEX"
msgstr "Excluir cualquier ruta o archivo existente que coincida con REGEX"

#: bin/sb2iso:31
msgid "Specify output ISO filename (default"
msgstr "Especificar nombre de archivo ISO de salida (predeterminado"

#: bin/sb2iso:32
msgid "Set menu type: multilang or language code"
msgstr "Establecer el tipo de menú: multilenguaje o código de idioma"

#: bin/sb2iso:33
msgid "  multilang: menu with language selection (default)"
msgstr "  multilenguaje: menú con selección de idioma (predeterminado)"

#: bin/sb2iso:34
msgid "  language: specific language (en_US, ru_RU, de_DE, etc.)"
msgstr "  idioma: idioma específico (en_US, ru_RU, de_DE, etc.)"

#: bin/sb2iso:39
msgid "Create basic MiniOS ISO with current system:"
msgstr "Crear una ISO básica de MiniOS con el sistema actual:"

